<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PastPresentEventSelector.Prepatch</AssemblyName>
    <RootNamespace>PPES.Prepatch</RootNamespace>
    <Version>1.6.1</Version>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- game install used only for references at build time -->
    <SPTPath Condition="'$(SPTPath)' == ''">C:\SPT</SPTPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(SPTPath)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mono.Cecil">
      <HintPath>$(SPTPath)\BepInEx\core\Mono.Cecil.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MoreBotsPrepatch">
      <HintPath>$(SPTPath)\BepInEx\patchers\MoreBotsPrepatch\MoreBotsPrepatch.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
