@inherits PpesSection
@inject PreviewService Previewer
@inject EventSchedule Schedule
@inject ISnackbar Snackbar

<section class="ppes-section">
    <div class="ppes-section-head">
        <MudIcon Icon="@Icons.Material.Filled.Map" Class="ppes-accent" />
        <div>
            <MudText Typo="Typo.h5">@T("Pr\u00e9via da raid", "Raid preview")</MudText>
            <MudText Typo="Typo.body2" Class="spt-muted">
                @T("O que a pr\u00f3xima raid teria com a sele\u00e7\u00e3o atual, salva ou n\u00e3o, incluindo a rota\u00e7\u00e3o. Usa os spawns atuais do servidor, j\u00e1 com o ABPS e os sazonais. Em Editar, mude a chance, as zonas e a escolta, tire ou adicione chefes e fac\u00e7\u00f5es. Suas mudan\u00e7as valem depois dos eventos, a partir da pr\u00f3xima raid, depois de salvar.",
                   "What the next raid would have with the current picks, saved or not, rotation included. Uses the server's current spawns, ABPS and seasonal events included. In Edit, change the chance, zones and escort, or remove and add bosses and factions. Your changes apply after the events, from the next raid, once saved.")
            </MudText>
        </div>
        <MudButton Class="ml-auto" Size="Size.Small" Variant="@(editing ? Variant.Filled : Variant.Outlined)" Color="Color.Warning"
                   StartIcon="@Icons.Material.Filled.Edit" OnClick="@(() => editing = !editing)">@(editing ? T("Concluir", "Done") : T("Editar", "Edit"))</MudButton>
    </div>
    <div class="ppes-maps" role="tablist">
        @foreach (var m in GameMaps.All)
        {
            <button role="tab" aria-selected="@(map == m.Id ? "true" : "false")" class="@($"{(map == m.Id ? "ppes-on" : "")} {(MapTouched(m.Id) ? "ppes-map-touched" : "")}")" @onclick="@(() => SelectMap(m.Id))">@T(m.NamePt, m.NameEn)@if (Working.SpawnsOf(m.Id).Count > 0){<MudIcon Icon="@Icons.Material.Filled.Edit" Class="ppes-map-edited" />}</button>
        }
    </div>
    @if (Preview is { } preview)
    {
        <MudPaper Elevation="0" Class="ppes-preview spt-panel">
            <div class="ppes-preview-badges">
                @if (preview.AirdropChance > 0)
                {
                    <span class="ppes-badge"><MudIcon Icon="@Icons.Material.Filled.FlightLand" /> Airdrop @Percent(preview.AirdropChance * 100)@(preview.AirdropMax > 1 ? T($", at\u00e9 {preview.AirdropMax}", $", up to {preview.AirdropMax}") : "")</span>
                }
                @if (preview.Mortar)
                {
                    <span class="ppes-badge ppes-badge-hot"><MudIcon Icon="@Icons.Material.Filled.Warning" /> @T("Morteiros", "Mortars")</span>
                }
                @if (preview.ZombieInfection is { } infection)
                {
                    <span class="ppes-badge ppes-badge-hot"><MudIcon Icon="@Icons.Material.Filled.Coronavirus" /> @T("Infec\u00e7\u00e3o zumbi", "Zombie infection") @Percent(infection)</span>
                }
                @if (preview.NeedsKeycard is { } keycard)
                {
                    <span class="ppes-badge"><MudIcon Icon="@Icons.Material.Filled.VpnKey" /> @(keycard ? T("Precisa de cart\u00e3o", "Keycard needed") : T("Sem cart\u00e3o", "No keycard"))</span>
                }
            </div>
            @if (preview.Spawns.Count == 0 && preview.Removed.Count == 0)
            {
                <span class="ppes-hint">@T("Nenhum chefe ou grupo especial neste mapa.", "No bosses or special groups on this map.")</span>
            }
            else
            {
                <div class="@($"ppes-table {(editing ? "ppes-table-edit" : "")}")" role="table">
                    <div class="ppes-tr ppes-th" role="row">
                        <span>@T("Quem", "Who")</span><span>@T("Chance", "Chance")</span><span>@T("Onde", "Where")</span><span>@T("Escolta", "Escort")</span>@if (editing){<span></span>}
                    </div>
                    @foreach (var s in preview.Spawns)
                    {
                        <div class="@($"ppes-tr {(s.Changed ? "ppes-tr-changed" : "")}")" role="row">
                            <span>@T(s.NamePt, s.NameEn)@if (s.Custom){<span class="ppes-changed ppes-custom">@T("seu", "yours")</span>}else if (s.Changed){<span class="ppes-changed">@T("evento", "event")</span>}</span>
                            @if (editing)
                            {
                                <input class="ppes-input ppes-cell" type="number" min="0" max="100" step="1" aria-label="@T("Chance", "Chance")" value="@s.Chance.ToString("0.#", CultureInfo.InvariantCulture)"
                                       @onchange="@(e => Edit(w => SpawnEditor.SetChance(w, map, s.Role, e.Value?.ToString())))" />
                                <div class="ppes-zone-editor">
                                    <select class="ppes-input ppes-cell ppes-zone-select" value="" aria-label="@T("Adicionar região", "Add region")"
                                            @onchange="@(e => Edit(w => SpawnEditor.AddZone(w, map, s.Role, e.Value?.ToString(), s.RawZones)))">
                                        <option value="">@T("Adicionar regi\u00e3o...", "Add region...")</option>
                                        @foreach (var zone in AvailableZones(s.RawZones))
                                        {
                                            <option value="@zone">@PreviewService.ZoneLabel(zone)</option>
                                        }
                                    </select>
                                    @if (ZoneList.Split(s.RawZones).Length > 0)
                                    {
                                        <div class="ppes-zone-chips" aria-label="@T("Remover zonas individualmente", "Remove zones individually")">
                                            @foreach (var zone in ZoneList.Split(s.RawZones))
                                            {
                                                <button class="ppes-zone-chip" type="button" title="@T($"Remover {PreviewService.ZoneLabel(zone)}", $"Remove {PreviewService.ZoneLabel(zone)}")"
                                                        aria-label="@T($"Remover região {PreviewService.ZoneLabel(zone)}", $"Remove region {PreviewService.ZoneLabel(zone)}")"
                                                        @onclick="@(() => Edit(w => SpawnEditor.RemoveZone(w, map, s.Role, zone, s.RawZones)))">
                                                    <span>@PreviewService.ZoneLabel(zone)</span><MudIcon Icon="@Icons.Material.Filled.Close" />
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                                <input class="ppes-input ppes-cell" aria-label="@T("Escolta", "Escort")" title="@T("Ex.: 2 ou 1-3", "E.g. 2 or 1-3")" value="@EscortValue(s)"
                                       @onchange="@(e => SetEscort(s.Role, e.Value?.ToString()))" />
                                <span class="ppes-row-actions">
                                    @if (s.Custom)
                                    {
                                        <button class="ppes-icon-btn" title="@T("Desfazer suas mudanças", "Undo your changes")" @onclick="@(() => Edit(w => SpawnEditor.ResetRole(w, map, s.Role)))"><MudIcon Icon="@Icons.Material.Filled.Undo" /></button>
                                    }
                                    <button class="ppes-icon-btn" title="@T("Tirar deste mapa", "Remove from this map")" @onclick="@(() => Edit(w => SpawnEditor.RemoveRole(w, map, s.Role)))"><MudIcon Icon="@Icons.Material.Filled.Close" /></button>
                                </span>
                            }
                            else
                            {
                                <span class="@(s.Chance >= 100 ? "ppes-sure" : "")">@Percent(s.Chance)</span>
                                <span class="ppes-zones">@(string.IsNullOrEmpty(s.Zones) ? T("por gatilho", "by trigger") : s.Zones)</span>
                                <span class="ppes-escort">@EscortText(s)</span>
                            }
                        </div>
                    }
                    @foreach (var s in preview.Removed)
                    {
                        <div class="ppes-tr ppes-tr-removed" role="row">
                            <span>@T(s.NamePt, s.NameEn)<span class="ppes-changed ppes-custom">@T("tirado", "removed")</span></span>
                            <span>@Percent(s.Chance)</span>
                            <span class="ppes-zones">@s.Zones</span>
                            <span class="ppes-escort">@EscortText(s)</span>
                            @if (editing)
                            {
                                <span class="ppes-row-actions"><button class="ppes-icon-btn" title="@T("Trazer de volta", "Bring back")" @onclick="@(() => Edit(w => SpawnEditor.ResetRole(w, map, s.Role)))"><MudIcon Icon="@Icons.Material.Filled.Undo" /></button></span>
                            }
                        </div>
                    }
                </div>
            }
            @if (editing)
            {
                var pending = Draft.NewSpawn;
                <div class="ppes-add-spawn">
                    <span class="ppes-label">@T("Adicionar:", "Add:")</span>
                    <select class="ppes-input" @bind="pending.Role" aria-label="@T("Chefe ou facção", "Boss or faction")">
                        <option value="">@T("Chefe ou fac\u00e7\u00e3o...", "Boss or faction...")</option>
                        @foreach (var r in BotRoles.AddableRoles().Where(r => preview.Spawns.All(x => !string.Equals(x.Role, r.Role, StringComparison.OrdinalIgnoreCase))))
                        {
                            <option value="@r.Role">@T(r.NamePt, r.NameEn)</option>
                        }
                    </select>
                    <input class="ppes-input ppes-number" type="number" min="1" max="100" aria-label="@T("Chance", "Chance")" @bind="pending.Chance" />
                    <span class="ppes-label">%</span>
                    <div class="ppes-add-zone-picker">
                        <select class="ppes-input ppes-add-zones" value="" aria-label="@T("Adicionar região", "Add region")"
                                @onchange="@(e => pending.Zones = ZoneList.Join(ZoneList.Split(pending.Zones).Append(e.Value?.ToString() ?? "").Where(z => z.Length > 0).Distinct(StringComparer.OrdinalIgnoreCase)) ?? "")">
                            <option value="">@T("Adicionar regi\u00e3o...", "Add region...")</option>
                            @foreach (var zone in AvailableZones(pending.Zones))
                            {
                                <option value="@zone">@PreviewService.ZoneLabel(zone)</option>
                            }
                        </select>
                        @if (ZoneList.Split(pending.Zones).Length > 0)
                        {
                            <div class="ppes-zone-chips" aria-label="@T("Regiões selecionadas", "Selected regions")">
                                @foreach (var zone in ZoneList.Split(pending.Zones))
                                {
                                    <button class="ppes-zone-chip" type="button" title="@T($"Remover {PreviewService.ZoneLabel(zone)}", $"Remove {PreviewService.ZoneLabel(zone)}")"
                                            @onclick="@(() => pending.Zones = ZoneList.Join(ZoneList.Split(pending.Zones).Where(z => !string.Equals(z, zone, StringComparison.OrdinalIgnoreCase))) ?? "")">
                                        <span>@PreviewService.ZoneLabel(zone)</span><MudIcon Icon="@Icons.Material.Filled.Close" />
                                    </button>
                                }
                            </div>
                        }
                    </div>
                    <input class="ppes-input ppes-number" placeholder="@T("Escolta", "Escort")" title="@T("Ex.: 2 ou 1-3", "E.g. 2 or 1-3")" aria-label="@T("Escolta", "Escort")" @bind="pending.Escort" />
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" Disabled="@string.IsNullOrEmpty(pending.Role)" OnClick="AddSpawn">@T("Adicionar", "Add")</MudButton>
                    @if (Working.SpawnsOf(map).Count > 0)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default" Class="ml-auto" OnClick="@(() => Edit(w => SpawnEditor.ResetMap(w, map)))">@T("Desfazer tudo neste mapa", "Undo all on this map")</MudButton>
                    }
                </div>
            }
        </MudPaper>
    }
    else if (previewError is not null)
    {
        <MudAlert Severity="Severity.Warning" Dense="true">@previewError</MudAlert>
    }
</section>

@code {
    private string map = "bigmap";
    private bool editing;
    private string? previewError;
    private (string Key, RaidPreview Value)? cache;

    private void Edit(Action<PpesConfig> change) => Draft.Edit(change);

    private RaidPreview? Preview
    {
        get
        {
            // the rotation's picks change with time, the rest of the result only with the selection
            var key = $"{map}|{Working.SelectionKey()}|{string.Join(",", Schedule.RaidEvents(Working, Now))}";
            if (cache is { } cached && cached.Key == key) return cached.Value;
            try
            {
                var value = Previewer.Preview(map, Working);
                cache = (key, value);
                previewError = null;
                return value;
            }
            catch (Exception ex)
            {
                previewError = T("N\u00e3o foi poss\u00edvel gerar a pr\u00e9via: ", "Could not build the preview: ") + ex.Message;
                return null;
            }
        }
    }

    private bool MapTouched(string mapId) =>
        Schedule.RaidEvents(Working, Now).Select(EventCatalog.Past).Any(e => e?.Maps.Contains(mapId) == true);

    private IEnumerable<string> AvailableZones(string currentZones)
    {
        var current = ZoneList.Split(currentZones).ToHashSet(StringComparer.OrdinalIgnoreCase);
        return Previewer.ZonesOf(map).Where(zone => !current.Contains(zone));
    }

    private void SelectMap(string mapId)
    {
        if (string.Equals(map, mapId, StringComparison.OrdinalIgnoreCase)) return;
        map = mapId;
        Draft.NewSpawn.Clear();
    }

    private void SetEscort(string role, string? text)
    {
        var ok = true;
        Edit(w => ok = SpawnEditor.SetEscort(w, map, role, text));
        if (!ok) Snackbar.Add(T("Escolta: use um n\u00famero (2) ou um intervalo (1-3).", "Escort: use a number (2) or a range (1-3)."), Severity.Warning);
    }

    private void AddSpawn()
    {
        var ok = true;
        Edit(w => ok = SpawnEditor.Add(w, map, Draft.NewSpawn));
        if (!ok) Snackbar.Add(T("Confira a chance e a escolta antes de adicionar. Escolta: use 2 ou 1-3.", "Check the chance and escort before adding. Escort: use 2 or 1-3."), Severity.Warning);
    }

    private static string EscortValue(PreviewSpawn s) => s.EscortMin == s.EscortMax ? $"{s.EscortMax}" : $"{s.EscortMin}-{s.EscortMax}";

    private string EscortText(PreviewSpawn s) =>
        s.EscortMax == 0 ? T("sozinho", "alone") : s.EscortMin == s.EscortMax ? $"{s.EscortMax}" : $"{s.EscortMin} {T("a", "to")} {s.EscortMax}";

    private static string Percent(double percent) => $"{percent:0.#}%";
}
