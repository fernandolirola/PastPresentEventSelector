    {
        if (Config.Saved.Language != language) Config.Update(c => c.Language = language);
    }

    private void SetView(string view) => Config.Update(c => c.View = view);

    private void ToggleYears() => Config.Update(c => c.GroupByYear = !c.GroupByYear);

