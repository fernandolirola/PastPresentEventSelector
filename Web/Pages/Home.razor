    private SpawnEdit EditOf(string role)
    {
        if (!working.Spawns.TryGetValue(previewMap, out var edits)) working.Spawns[previewMap] = edits = [];
        var edit = edits.FirstOrDefault(e => string.Equals(e.Role, role, StringComparison.OrdinalIgnoreCase));
        if (edit is null) edits.Add(edit = new SpawnEdit { Role = role });
        return edit;
    }

    private void SetChance(string role, string? text)
    {
        if (double.TryParse(text, NumberStyles.Float, CultureInfo.InvariantCulture, out var chance)) EditOf(role).Chance = Math.Clamp(chance, 0, 100);
    }

    private void SetZones(string role, string? text)
    {
        var zones = string.Join(",", (text ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries));
        // An empty value clears this override and restores the map's original zones.
        EditOf(role).Zones = zones.Length > 0 ? zones : null;
    }

    private static string[] ZoneTokens(string? zones) =>
        (zones ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray();

    private IEnumerable<string> AvailableZones(string? currentZones)
    {
        var current = ZoneTokens(currentZones).ToHashSet(StringComparer.OrdinalIgnoreCase);
        return Previewer.ZonesOf(previewMap).Where(zone => !current.Contains(zone));
    }

    private void SelectPreviewMap(string mapId)
    {
        if (string.Equals(previewMap, mapId, StringComparison.OrdinalIgnoreCase)) return;
        previewMap = mapId;
        addRole = addZones = addEscort = "";
        addChance = 100;
    }

    private void AddZone(string role, string? zone, string? currentZones)
    {
        if (string.IsNullOrWhiteSpace(zone)) return;
        SetZones(role, string.Join(",", ZoneTokens(currentZones).Append(zone).Distinct(StringComparer.OrdinalIgnoreCase)));
    }

    private void AddPendingZone(string? zone)
    {
        if (string.IsNullOrWhiteSpace(zone)) return;
        addZones = string.Join(",", ZoneTokens(addZones).Append(zone).Distinct(StringComparer.OrdinalIgnoreCase));
    }

    private void RemovePendingZone(string zone) =>
        addZones = string.Join(",", ZoneTokens(addZones).Where(candidate => !string.Equals(candidate, zone, StringComparison.OrdinalIgnoreCase)));

    private void RemoveZone(string role, string zone, string? currentZones)
    {
        var remaining = ZoneTokens(currentZones)
            .Where(candidate => !string.Equals(candidate, zone, StringComparison.OrdinalIgnoreCase))
            .ToArray();
        if (remaining.Length > 0) SetZones(role, string.Join(",", remaining));
        else RemoveRole(role);
    }

    private void SetEscort(string role, string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            var edit = working.SpawnsOf(previewMap).FirstOrDefault(e => string.Equals(e.Role, role, StringComparison.OrdinalIgnoreCase));
            if (edit is not null)
            {
                edit.Escort = null;
                if (!edit.Remove && edit.Chance is null && edit.Zones is null) ResetRole(role);
            }
            return;
        }
        if (SpawnEdits.NormalizeEscort(text) is { } escort) EditOf(role).Escort = escort;
        else Snackbar.Add(T("Escolta: use um número (2) ou um intervalo (1-3).", "Escort: use a number (2) or a range (1-3)."), Severity.Warning);
    }

    private void RemoveRole(string role)
    {
        var edit = EditOf(role);
        edit.Remove = true;
        edit.Chance = null;
        edit.Zones = null;
        edit.Escort = null;
    }

    private void ResetRole(string role) => working.Spawns.GetValueOrDefault(previewMap)?.RemoveAll(e => string.Equals(e.Role, role, StringComparison.OrdinalIgnoreCase));

    private void ResetMap() => working.Spawns.Remove(previewMap);

    private void AddSpawn()
    {
        if (string.IsNullOrEmpty(addRole)) return;
        var escort = SpawnEdits.NormalizeEscort(addEscort);
        if ((!string.IsNullOrWhiteSpace(addEscort) && escort is null) || !double.IsFinite(addChance))
        {
            Snackbar.Add(T("Confira a chance e a escolta antes de adicionar. Escolta: use 2 ou 1-3.", "Check the chance and escort before adding. Escort: use 2 or 1-3."), Severity.Warning);
            return;
        }
        ResetRole(addRole);
        var edit = EditOf(addRole);
        edit.Chance = Math.Clamp(addChance, 1, 100);
        var zones = string.Join(",", addZones.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries));
        edit.Zones = zones.Length > 0 ? zones : null;
        edit.Escort = escort;
        addRole = addZones = addEscort = "";
        addChance = 100;
    }

    private static string EscortValue(PreviewSpawn s) => s.EscortMin == s.EscortMax ? $"{s.EscortMax}" : $"{s.EscortMin}-{s.EscortMax}";

    private string EscortText(PreviewSpawn s) =>
        s.EscortMax == 0 ? T("sozinho", "alone") : s.EscortMin == s.EscortMax ? $"{s.EscortMax}" : $"{s.EscortMin} {T("a", "to")} {s.EscortMax}";

    private static string Percent(double chance) => chance <= 1 ? $"{chance * 100:0}%" : $"{chance:0}%";

    private string FormatDate(DateTime date) => IsPt ? $"{date.Day} {MonthsPt[date.Month - 1]}" : $"{MonthsEn[date.Month - 1]} {date.Day}";

    private string WindowText(string id)
    {
        var windows = Calendar.WindowsOf(id);
        if (windows.Count == 0) return T("Sem datas no SPT", "No dates in SPT");
        return string.Join(" + ", windows.Select(w =>
        {
            var start = new DateTime(2000, w.StartMonth, w.StartDay);
            var end = new DateTime(2000, w.EndMonth, w.EndDay);
            return start == end ? FormatDate(start) : $"{FormatDate(start)} {T("a", "to")} {FormatDate(end)}";
        }));
    }

    /// <summary>Auto mode: days left when in season, otherwise days until the next start.</summary>
    private string SeasonalHint(string id, string mode)
    {
        if (working.SeasonalRotation.Mode != SeasonalRotationMode.Off)
            return mode == SeasonalMode.Off ? T("Fora da rotação.", "Left out of the rotation.") : T("Na rotação: entra quando for sorteado.", "In the rotation: on when drawn.");
        if (mode != SeasonalMode.Auto) return mode == SeasonalMode.On ? T("Forçado: ligado todo dia.", "Forced: on every day.") : T("Desligado mesmo nas datas.", "Off even during its dates.");
        var windows = Calendar.WindowsOf(id);
        if (windows.Count == 0) return "";
        var today = Today;
        var current = windows.FirstOrDefault(w => today >= new DateTime(today.Year, w.StartMonth, w.StartDay) && today <= new DateTime(today.Year, w.EndMonth, w.EndDay));
        if (current is not null)
        {
            var left = (new DateTime(today.Year, current.EndMonth, current.EndDay) - today).Days;
            return left == 0 ? T("Automático: último dia hoje.", "Auto: last day today.") : T($"Automático: termina em {left} dia(s).", $"Auto: ends in {left} day(s).");
        }
        var next = windows.Select(w =>
        {
            var start = new DateTime(today.Year, w.StartMonth, w.StartDay);
            return start < today ? start.AddYears(1) : start;
        }).Min();
        var days = (next - today).Days;
        return T($"Automático: começa em {days} dia(s).", $"Auto: starts in {days} day(s).");
    }

    private string WhenText(string when)
    {
        if (!IsPt) return when;
        var text = when.Replace(" to ", " a ");
        for (var i = 0; i < 12; i++) text = text.Replace(MonthsEn[i], MonthsPt[i]);
        return text;
    }
