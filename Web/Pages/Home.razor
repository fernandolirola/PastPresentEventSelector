        RotationMode.Hourly => T($"Sorteados agora, até {rotation.Until:HH:mm}:", $"Drawn now, until {rotation.Until:HH:mm}:"),
        RotationMode.Daily => T("Sorteados para hoje:", "Drawn for today:"),
        _ when rotation.Active => T($"Sorteados agora, ligados até {FormatDate(rotation.Until.AddDays(-1))}:", $"Drawn now, on until {FormatDate(rotation.Until.AddDays(-1))}:"),
        _ => T($"Sorteio do próximo fim de semana ({FormatDate(rotation.From)} e {FormatDate(rotation.From.AddDays(1))}):", $"Next weekend's draw ({FormatDate(rotation.From)} and {FormatDate(rotation.From.AddDays(1))}):"),
