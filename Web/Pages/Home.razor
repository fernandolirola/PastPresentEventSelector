        [EventKind.Bosses, EventKind.Quests, EventKind.Traders, EventKind.Flea, EventKind.Airdrops, EventKind.Hideout, EventKind.Rules, EventKind.Access, EventKind.Hazard];

    private static int RotationMax => EventSchedule.RotationPool.Count();

    private static readonly string[] MonthsEn = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
    private static readonly string[] MonthsPt = ["jan", "fev", "mar", "abr", "mai", "jun", "jul", "ago", "set", "out", "nov", "dez"];

    private PpesConfig working = new();
    private PpesConfig draftBaseline = new();
