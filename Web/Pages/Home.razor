@page "/ppes"
@attribute [Authorize(Policy = "Administrator")]
@layout BaseMudBlazorLayout
@implements IDisposable
@inject ConfigService Config
@inject SeasonalCalendar Calendar
@inject CompatibilityService Compat
@inject QuestAvailability QuestCheck
@inject PreviewService Previewer
@inject ISnackbar Snackbar
@using System.Globalization

<PageTitle>Past &amp; Present Event Selector</PageTitle>

<HeadContent>
    <link href="/PastPresentEventSelector/css/ppes.css" rel="stylesheet" />
</HeadContent>

<div class="ppes-page spt-page">
    <MudContainer MaxWidth="MaxWidth.False" Class="ppes-container pa-6">

        <MudPaper Elevation="0" Class="ppes-hero ppes-app-header spt-panel">
            <div class="ppes-hero-copy">
                <MudText Typo="Typo.overline" Class="spt-kicker">zezinho's</MudText>
                <MudText Typo="Typo.h5" Class="spt-title">Past &amp; Present Event Selector</MudText>

            </div>
            <div class="ppes-hero-actions">
                <div class="ppes-lang" role="group" aria-label="Language">
                    <button class="@(IsPt ? "" : "ppes-on")" @onclick="@(() => SetLanguage("en"))" title="English">EN</button>
                    <button class="@(IsPt ? "ppes-on" : "")" @onclick="@(() => SetLanguage("pt"))" title="Português">PT</button>
                </div>
                <div class="ppes-save-row">
                    @if (IsDirty || draftConflict)
                    {
                        <span class="ppes-dirty"><MudIcon Icon="@Icons.Material.Filled.Circle" Size="Size.Small" /> @T("Alterações não salvas", "Unsaved changes")</span>
                        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="Discard">@T("Descartar", "Discard")</MudButton>
                    }
                    <MudButton Variant="Variant.Filled" Color="Color.Warning" Disabled="@(!IsDirty)" StartIcon="@Icons.Material.Filled.Save" OnClick="Save">@T("Salvar", "Save")</MudButton>
                </div>
            </div>
        </MudPaper>

        <div class="ppes-workspace">
            <aside class="ppes-sidebar spt-panel">
                <span class="ppes-nav-label">@T("Configura\u00e7\u00e3o", "Configuration")</span>
                <nav class="ppes-navigation" aria-label="@T("Menu principal do PPES", "PPES main menu")">
                    @foreach (var destination in Sections)
                    {
                        <button type="button" class="@(activeSection == destination.Id ? "ppes-selected" : "")" aria-current="@(activeSection == destination.Id ? "page" : null)" @onclick="@(() => activeSection = destination.Id)">
                            <MudIcon Icon="@(destination.Icon)" /><span>@T(destination.Pt, destination.En)</span>
                        </button>
                    }
                </nav>
                <span class="ppes-hint ppes-sidebar-note">@T("Trocar de menu preserva as altera\u00e7\u00f5es n\u00e3o salvas.", "Switching menus keeps your unsaved changes.")</span>
            </aside>
            <div class="ppes-main" id="ppes-main" role="region" aria-label="@T("Conte\u00fado da configura\u00e7\u00e3o", "Configuration content")">
        @if (draftConflict)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                @T("A configura\u00e7\u00e3o foi salva em outra p\u00e1gina. Suas altera\u00e7\u00f5es continuam aqui; use Descartar para carregar a vers\u00e3o salva antes de editar novamente.", "Another page saved the configuration. Your draft is still here; use Discard to load the saved version before editing again.")
            </MudAlert>
        }
        @if (PendingRestart.Count > 0)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                @T("Reinicie o servidor para aplicar: ", "Restart the server to apply: ")<strong>@string.Join(", ", PendingRestart)</strong>.
                @T(" Eventos de boss e de airdrop valem já na próxima raid.", " Boss and airdrop events already apply from the next raid.")
            </MudAlert>
        }

        @foreach (var note in Compat.Notes)
        {
            <MudAlert Severity="@(note.Warning ? Severity.Warning : Severity.Info)" Dense="true">@T(note.Pt, note.En)</MudAlert>
        }

        @if (activeSection == "overview")
        {
            <section class="ppes-section" aria-labelledby="ppes-overview-title">
                <div class="ppes-section-head"><MudIcon Icon="@Icons.Material.Filled.Dashboard" Class="ppes-accent" /><div>
                    <MudText Typo="Typo.h5" id="ppes-overview-title">@T("Vis\u00e3o geral", "Overview")</MudText>
                    <MudText Typo="Typo.body2" Class="spt-muted">@T("Confira sua sele\u00e7\u00e3o antes da pr\u00f3xima raid. A pr\u00e9via inclui altera\u00e7\u00f5es ainda n\u00e3o salvas.", "Check your selection before the next raid. This overview includes unsaved changes.")</MudText>
                </div></div>
                <div class="ppes-overview-grid">
                    <MudPaper Elevation="0" Class="ppes-panel spt-panel">
                        <MudText Typo="Typo.h6">@T("Eventos sazonais", "Seasonal events")</MudText>
                        @foreach (var item in EventCatalog.Seasonal)
                        {
                            <button type="button" class="ppes-overview-event" @onclick="@(() => OpenSeasonal(item.Id))"><span>@T(item.NamePt, item.NameEn)</span><span class="ppes-status @(IsSeasonalActive(working, item.Id) ? "ppes-status-on" : "")">@(IsSeasonalActive(working, item.Id) ? T("Ativo", "Active") : T("Desligado", "Off"))</span></button>
                        }
                        <span class="ppes-hint">@T("No modo Autom\u00e1tico, os sazonais seguem suas datas.", "In Auto mode, seasonal events follow their dates.")</span>
                    </MudPaper>
                    <MudPaper Elevation="0" Class="ppes-panel spt-panel">
                        <MudText Typo="Typo.h6">@T("Eventos antigos selecionados", "Selected past events")</MudText>
                        @if (working.Events.Count == 0)
                        {
                            <span class="ppes-hint">@T("Nenhum evento escolhido. Escolha eventos ou aplique um preset.", "No events selected. Choose events or apply a preset.")</span>
                        }
                        @foreach (var id in working.Events)
                        {
                            <span class="ppes-overview-event"><span>@EventCatalog.Past(id)?.Name</span><span class="ppes-hint">@(EventCatalog.Past(id)?.NeedsRestart == true ? T("Reiniciar servidor", "Server restart") : T("Pr\u00f3xima raid", "Next raid"))</span></span>
                        }
                        <div class="ppes-row"><button type="button" class="ppes-chip" @onclick="@(() => activeSection = "events")">@T("Escolher eventos", "Browse events")</button><button type="button" class="ppes-chip" @onclick="@(() => OpenSettings("presets"))">Presets</button></div>
                    </MudPaper>
                    <MudPaper Elevation="0" Class="ppes-panel spt-panel ppes-overview-wide">
                        <div class="ppes-panel-head"><MudIcon Icon="@Icons.Material.Filled.Map" Class="ppes-accent" /><MudText Typo="Typo.h6">@T("Antes de entrar na raid", "Before you raid")</MudText></div>
                        <span class="ppes-hint">@T("Eventos de boss e airdrop valem na pr\u00f3xima raid. Sazonais, quests e regras do servidor precisam reiniciar. O comportamento com zumbis vale em at\u00e9 30 segundos com o plugin do cliente.", "Boss and airdrop events apply next raid. Seasonal events, quests and server rules need a restart. Zombie behavior applies within 30 seconds with the client plugin.")</span>
                        <div class="ppes-row"><button type="button" class="ppes-chip" @onclick="@(() => activeSection = "raid")">@T("Abrir configura\u00e7\u00e3o da raid", "Open raid setup")</button></div>
                    </MudPaper>
                </div>
            </section>
        }

        @* ---------- seasonal ---------- *@
        @if (activeSection == "seasonal")
        {
        <section class="ppes-section">
            <div class="ppes-section-head">
                <MudIcon Icon="@Icons.Material.Filled.Event" Class="ppes-accent" />
                <div>
                    <MudText Typo="Typo.h5">@T("Eventos sazonais", "Seasonal events")</MudText>
                    <MudText Typo="Typo.body2" Class="spt-muted">
                        @T($"Hoje é {FormatDate(Today)}. No modo Automático, o evento liga sozinho nas datas dele.", $"Today is {FormatDate(Today)}. In Auto mode an event turns on by itself during its dates.")
                    </MudText>
                </div>
            </div>

            @if (EffectiveSeasonal.Count > 1)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                    @T("Mais de um evento sazonal ligado. O SPT aplica todos, mas as quests e itens de evento seguem só o último da lista. Pode haver efeitos estranhos.",
                       "More than one seasonal event is on. SPT applies them all, but event quests and items only follow the last one in the list. Expect some odd results.")
                </MudAlert>
            }



            <div class="ppes-seasonal-workspace">
                <nav class="ppes-seasonal-picker" aria-label="@T("Escolher evento sazonal", "Choose seasonal event")">
                    @foreach (var item in EventCatalog.Seasonal)
                    {
                        <button type="button" class="ppes-seasonal-pick @(selectedSeasonal == item.Id ? "ppes-selected" : "")" aria-current="@(selectedSeasonal == item.Id ? "page" : null)" @onclick="@(() => selectedSeasonal = item.Id)">
                            <span><strong>@T(item.NamePt, item.NameEn)</strong><small>@WindowText(item.Id)</small></span>
                            <span class="ppes-status @(IsSeasonalActive(working, item.Id) ? "ppes-status-on" : "")">@(IsSeasonalActive(working, item.Id) ? T("Ativo", "Active") : T("Desligado", "Off"))</span>
                        </button>
                    }
                    <button type="button" class="ppes-chip" @onclick="@(() => OpenSettings("rotation"))">@T("Rota\u00e7\u00e3o dos sazonais", "Seasonal rotation")</button>
                </nav>
                <div class="ppes-seasonal-detail">

                @foreach (var s in EventCatalog.Seasonal.Where(s => s.Id == selectedSeasonal))
                {
                    var mode = working.ModeOf(s.Id);
                    var active = IsSeasonalActive(working, s.Id);
                    <MudPaper Elevation="0" Class="@($"ppes-card spt-panel {(active ? "ppes-card-on" : "")}")">
                        <div class="ppes-card-head">
                            <div>
                                <MudText Typo="Typo.h6">@T(s.NamePt, s.NameEn)</MudText>
                                <span class="ppes-meta">@WindowText(s.Id)@WikiLink(s.Id)</span>
                            </div>
                            <span class="@($"ppes-status {(active ? "ppes-status-on" : "")}")">@(active ? T("Ativo", "Active") : T("Desligado", "Off"))</span>
                        </div>
                        <MudText Typo="Typo.body2" Class="spt-muted">@T(s.DescPt, s.DescEn)</MudText>
                        <div class="ppes-segmented" role="radiogroup">
                            @foreach (var (value, pt, en) in Modes)
                            {
                                <button role="radio" aria-checked="@(mode == value ? "true" : "false")" class="@(mode == value ? "ppes-on" : "")" @onclick="@(() => SetMode(s.Id, value))">@T(pt, en)</button>
                            }
                        </div>
                        @if (PartsOf(s.Id) is { Count: > 0 } partList)
                        {
                            <div class="@($"ppes-parts {(active ? "" : "ppes-parts-off")}")">
                                <span class="ppes-label">@PartsTitle(s.Id)</span>
                                @if (s.Id == "halloween")
                                {
                                    <div class="@($"ppes-part-status {(working.Halloween.ZombiesOn ? "ppes-part-status-on" : "ppes-part-status-off")}")">
                                        <strong>@(working.Halloween.ZombiesOn ? T("Aparecimento de zumbis: LIGADO", "Zombie spawning: ON") : T("Aparecimento de zumbis: DESLIGADO", "Zombie spawning: OFF"))</strong>
                                        <span>@HalloweenZombieStatus()</span>
                                    </div>
                                    <label class="ppes-behavior">
                                        <span class="ppes-part-name">@T("Comportamento dos bots com zumbis", "Bot behavior with zombies")</span>
                                        <select class="ppes-input" value="@(working.Halloween.BotsHideFromZombies ? "hide" : "normal")"
                                                @onchange="@(e => working.Halloween.BotsHideFromZombies = e.Value?.ToString() == "hide")">
                                            <option value="normal">@T("IA normal (patrulha e combate)", "Normal AI (patrol and combat)")</option>
                                            <option value="hide">@T("Esconder dos zumbis (padrão do jogo)", "Hide from zombies (game default)")</option>
                                        </select>
                                        <span class="ppes-part-hint">@T("IA normal remove a ordem de se esconder do Halloween. Movimento e combate seguem a IA e as regras de hostilidade ativas. Requer o plugin do cliente; vale em até 30 segundos após salvar, sem reiniciar.", "Normal AI removes the Halloween hiding order. Movement and combat follow the active AI and hostility rules. Requires the client plugin; applies within 30 seconds of saving, without a restart.")</span>
                                    </label>
                                }
                                @if (s.Id == "halloween")
                                {
                                    @foreach (var part in partList.Where(p => p.Key is "h.zombies" or "h.waves"))
                                    {
                                        @SeasonalOption(part)
                                    }
                                    <details class="ppes-options" open="@expandedSeasonal.Contains(s.Id)">
                                        <summary @onclick="@(() => ToggleSeasonalDetails(s.Id))">@T("Ritual, cultistas e regras do mapa", "Ritual, cultists and map rules")</summary>
                                        <div class="ppes-option-list">
                                            @foreach (var part in partList.Where(p => p.Key is not ("h.zombies" or "h.waves")))
                                            {
                                                @SeasonalOption(part)
                                            }
                                        </div>
                                    </details>
                                }
                                else
                                {
                                    @foreach (var part in partList) { @SeasonalOption(part) }
                                    @if (s.Id is "christmas" or "newyears")
                                    {
                                        <span class="ppes-hint">@T("Natal e Ano Novo compartilham estas op\u00e7\u00f5es.", "Christmas and New Year share these options.")</span>
                                    }
                                }
                            </div>
                        }
                        <div class="ppes-card-foot">
                            <span class="ppes-hint">@SeasonalHint(s.Id, mode)</span>
                            @QuestInfo(EventCatalog.SeasonalQuests(s.Id))
                        </div>
                    </MudPaper>
                }
            </div>
            </div>
        </section>
        }

        @if (activeSection == "settings")
        {
        <section class="ppes-section" aria-labelledby="ppes-settings-title">
            <div class="ppes-section-head"><MudIcon Icon="@Icons.Material.Filled.Tune" Class="ppes-accent" /><div>
                <MudText Typo="Typo.h5" id="ppes-settings-title">@T("Configura\u00e7\u00f5es", "Settings")</MudText>
                <MudText Typo="Typo.body2" Class="spt-muted">@T("Mec\u00e2nicas, rota\u00e7\u00e3o e prefer\u00eancias, cada uma no seu lugar.", "Mechanics, automation and preferences, each in its own place.")</MudText>
            </div></div>
            <nav class="ppes-settings-nav" aria-label="@T("Categorias de configura\u00e7\u00e3o", "Settings categories")">
                @foreach (var tab in SettingsTabs)
                {
                    <button type="button" class="ppes-chip @(settingsTab == tab.Id ? "ppes-selected" : "")" aria-current="@(settingsTab == tab.Id ? "page" : null)" @onclick="@(() => settingsTab = tab.Id)">@T(tab.Pt, tab.En)</button>
                }
            </nav>
            @if (settingsTab == "mechanics")
            {
            <MudPaper Elevation="0" Class="ppes-panel spt-panel">
                <div class="ppes-panel-head">
                    <MudIcon Icon="@Icons.Material.Filled.Tune" Class="ppes-accent" />
                    <MudText Typo="Typo.h6">@T("Mecânicas", "Mechanics")</MudText>
                </div>
                <MudText Typo="Typo.body2" Class="spt-muted">@T("Valores exatos; o padrão é o do jogo. As travas valem no próximo raide e precisam do plugin do cliente. O resto precisa reiniciar o servidor.", "Exact values; the default is the game's. Jams apply from the next raid and need the client plugin. The rest need a server restart.")</MudText>
                <div class="ppes-mechanics-grid">
                @foreach (var row in MechanicRows)
                {
                    <div class="ppes-mech">
                        <span class="ppes-label">@T(row.Pt, row.En) <span class="ppes-tag">@T(row.ScopePt, row.ScopeEn)</span></span>
                        <div class="ppes-mech-input">
                            <input class="ppes-input ppes-number" type="number" min="@row.Min" max="@row.Max" step="@row.Step" aria-label="@T(row.Pt, row.En)"
                                   value="@MechValue(row.Key)" @onchange="@(e => SetMech(row.Key, e.Value?.ToString()))" />
                            <span>@row.Unit</span>
                        </div>
                        <span class="ppes-hint">@T(row.HintPt, row.HintEn)</span>
                    </div>
                }
                </div>
            </MudPaper>
            }
            @if (settingsTab == "presets")
            {
            <MudPaper Elevation="0" Class="ppes-panel spt-panel">
                <div class="ppes-panel-head">
                    <MudIcon Icon="@Icons.Material.Filled.Bookmarks" Class="ppes-accent" />
                    <MudText Typo="Typo.h6">@T("Presets", "Presets")</MudText>
                </div>
                <MudText Typo="Typo.body2" Class="spt-muted">@T("Aplica um conjunto de eventos. Depois é só salvar.", "Applies a set of events. Then just save.")</MudText>
                <div class="ppes-chips">
                    @foreach (var p in EventDetails.Presets)
                    {
                        <button class="ppes-chip" title="@T(p.DescPt, p.DescEn)" @onclick="@(() => ApplyPreset(p.Events, p.Id == "vanilla" ? AllAuto() : null))">@T(p.NamePt, p.NameEn)</button>
                    }
                    @foreach (var (name, preset) in Config.Saved.Presets)
                    {
                        <span class="ppes-chip ppes-chip-custom">
                            <button @onclick="@(() => ApplyPreset(preset.Events, preset.Seasonal))">@name</button>
                            <button class="ppes-chip-x" title="@T("Apagar preset", "Delete preset")" @onclick="@(() => DeletePreset(name))">×</button>
                        </span>
                    }
                </div>
                <div class="ppes-inline-form">
                    <input class="ppes-input" placeholder="@T("Nome do seu preset", "Your preset name")" maxlength="40" @bind="presetName" @bind:event="oninput" />
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" Disabled="@string.IsNullOrWhiteSpace(presetName)" OnClick="SavePreset">@T("Salvar seleção atual", "Save current picks")</MudButton>
                </div>
            </MudPaper>
            }
            @if (settingsTab == "rotation")
            {
            <MudPaper Elevation="0" Class="ppes-panel spt-panel">
                <div class="ppes-panel-head">
                    <MudIcon Icon="@Icons.Material.Filled.Autorenew" Class="ppes-accent" />
                    <MudText Typo="Typo.h6">@T("Rotação automática", "Automatic rotation")</MudText>
                </div>
                <MudText Typo="Typo.body2" Class="spt-muted">@T("O servidor sorteia eventos sozinho e liga pra você: a cada hora, dia, semana, só nos fins de semana ou a cada tantas raids. Eles somam com os que você ligou e trocam sozinhos. Só entram no sorteio eventos que valem na próxima raid, então não precisa reiniciar.", "The server draws events by itself and turns them on for you: every hour, day or week, only on weekends, or every few raids. They add to the ones you turned on and change on their own. Only events that apply from the next raid are drawn, so no restart is needed.")</MudText>
                <div class="ppes-row">
                    <span class="ppes-label">@T("Sortear:", "Draw:")</span>
                    <div class="ppes-segmented" role="radiogroup">
                        @foreach (var (value, pt, en) in RotationModes)
                        {
                            <button role="radio" aria-checked="@(working.Rotation.Mode == value ? "true" : "false")" class="@(working.Rotation.Mode == value ? "ppes-on" : "")" @onclick="@(() => working.Rotation.Mode = value)">@T(pt, en)</button>
                        }
                    </div>
                    @if (working.Rotation.Mode == RotationMode.Raids)
                    {
                        <span class="ppes-label">@T("A cada", "Every")</span>
                        <input class="ppes-input ppes-number" type="number" min="1" max="50" aria-label="@T("Raids por sorteio", "Raids per draw")"
                               value="@working.Rotation.Raids" @onchange="@(e => working.Rotation.Raids = Math.Clamp(int.TryParse(e.Value?.ToString(), out var n) ? n : 1, 1, 50))" />
                        <span class="ppes-label">raids</span>
                    }
                    @if (working.Rotation.Mode != RotationMode.Off)
                    {
                        <span class="ppes-label">@T("Quantos:", "How many:")</span>
                        <input class="ppes-input ppes-number" type="number" min="1" max="@RotationMax" aria-label="@T("Quantidade", "Amount")"
                               value="@working.Rotation.Count" @onchange="@(e => working.Rotation.Count = Math.Clamp(int.TryParse(e.Value?.ToString(), out var n) ? n : 1, 1, RotationMax))" />
                        <span class="ppes-label">@T($"de {RotationMax}", $"of {RotationMax}")</span>
                    }
                </div>
                @if (working.Rotation.Mode != RotationMode.Off)
                {
                    var rotation = EventSchedule.Rotation(working, Now);
                    <div class="ppes-rotation">
                        <span class="ppes-hint">
                            @RotationText(rotation)
                        </span>
                        @foreach (var id in rotation.Picks)
                        {
                            <span class="@($"ppes-pill {(rotation.Active ? "ppes-pill-on" : "")}")">@EventCatalog.Past(id)?.Name</span>
                        }
                    </div>
                }
            </MudPaper>
            <MudPaper Elevation="0" Class="ppes-panel spt-panel mb-3">
                <div class="ppes-panel-head">
                    <MudIcon Icon="@Icons.Material.Filled.Shuffle" Class="ppes-accent" />
                    <MudText Typo="Typo.h6">@T("Rotação dos sazonais", "Seasonal rotation")</MudText>
                </div>
                <MudText Typo="Typo.body2" Class="spt-muted">@T("Em vez do calendário, um evento sazonal sorteado fica ligado em cada período, e às vezes nenhum, para dar uma pausa. Eventos em Desligado ficam fora do sorteio. O SPT só escolhe os sazonais ao iniciar, então um período novo vale depois de reiniciar o servidor.", "Instead of the calendar, one random seasonal event is on each period, and sometimes none for a break. Events set to Off stay out of the draw. SPT only picks seasonal events at startup, so a new period applies after a server restart.")</MudText>
                <div class="ppes-row">
                    <span class="ppes-label">@T("Sortear:", "Draw:")</span>
                    <div class="ppes-segmented" role="radiogroup">
                        @foreach (var (value, pt, en) in SeasonalRotationModes)
                        {
                            <button role="radio" aria-checked="@(working.SeasonalRotation.Mode == value ? "true" : "false")" class="@(working.SeasonalRotation.Mode == value ? "ppes-on" : "")" @onclick="@(() => working.SeasonalRotation.Mode = value)">@T(pt, en)</button>
                        }
                    </div>
                    @if (working.SeasonalRotation.Mode != SeasonalRotationMode.Off)
                    {
                        <span class="ppes-label">@T("Chance de pausa:", "Break chance:")</span>
                        <input class="ppes-input ppes-number" type="number" min="0" max="90" aria-label="@T("Chance de pausa", "Break chance")"
                               value="@working.SeasonalRotation.BreakChance" @onchange="@(e => working.SeasonalRotation.BreakChance = Math.Clamp(int.TryParse(e.Value?.ToString(), out var n) ? n : 0, 0, 90))" />
                        <span class="ppes-label">%</span>
                    }
                </div>
                @if (EventSchedule.SeasonalRotation(working, Today) is { Active: true } seasonalDraw)
                {
                    <div class="ppes-rotation">
                        <span class="ppes-hint">@T($"Período atual, até {FormatDate(seasonalDraw.Until.AddDays(-1))}:", $"This period, until {FormatDate(seasonalDraw.Until.AddDays(-1))}:")</span>
                        <span class="ppes-pill ppes-pill-on">@(seasonalDraw.Pick is { } pick ? SeasonalName(pick) : T("pausa, nenhum evento", "break, no event"))</span>
                    </div>
                }
            </MudPaper>
            }
            @if (settingsTab == "notice")
            {
            <MudPaper Elevation="0" Class="ppes-panel spt-panel">
                <div class="ppes-panel-head">
                    <MudIcon Icon="@Icons.Material.Filled.Mail" Class="ppes-accent" />
                    <MudText Typo="Typo.h6">@T("Aviso no jogo", "In-game notice")</MudText>
                    <MudSwitch T="bool" Value="@working.TraderMessage" ValueChanged="@(v => working.TraderMessage = v)" Color="Color.Warning" Class="ml-auto" aria-label="@T("Aviso no jogo", "In-game notice")" />
                </div>
                <MudText Typo="Typo.body2" Class="spt-muted">
                    @T("Quando você entra no jogo, o Fence manda uma mensagem com os boatos dos eventos ativos. Só manda de novo quando os eventos mudam.",
                       "When you log in, Fence sends a message with rumors about the active events. It only sends again when the events change.")
                </MudText>
            </MudPaper>
            }
        </section>
        }

        @* ---------- past events ---------- *@
        @if (activeSection == "events")
        {
        <section class="ppes-section">
            <div class="ppes-section-head">
                <MudIcon Icon="@Icons.Material.Filled.History" Class="ppes-accent" />
                <div>
                    <MudText Typo="Typo.h5">@T("Eventos antigos", "Past events")</MudText>
                    <MudText Typo="Typo.body2" Class="spt-muted">
                        @T($"{working.Events.Count} de {EventCatalog.PastEvents.Count} ligados.", $"{working.Events.Count} of {EventCatalog.PastEvents.Count} on.")
                    </MudText>
                </div>
            </div>

            <div class="ppes-toolbar">
                <input class="ppes-input ppes-search" type="search" placeholder="@T("Buscar evento...", "Search events...")" @bind="search" @bind:event="oninput" />
                <select class="ppes-input" @bind="mapFilter" aria-label="@T("Mapa", "Map")">
                    <option value="">@T("Todos os mapas", "All maps")</option>
                    @foreach (var m in EventDetails.Maps)
                    {
                        <option value="@m.Id">@T(m.NamePt, m.NameEn)</option>
                    }
                </select>
                <select class="ppes-input" @bind="kindFilter" aria-label="@T("Tipo", "Type")">
                    <option value="">@T("Todos os tipos", "All types")</option>
                    @foreach (var k in KindList)
                    {
                        <option value="@k.ToString()">@KindLabel(k)</option>
                    }
                </select>
                <div class="ppes-filters">
                    @foreach (var (value, pt, en) in Filters)
                    {
                        <button class="@(filter == value ? "ppes-on" : "")" @onclick="@(() => filter = value)">@T(pt, en)</button>
                    }
                </div>
                <div class="ppes-segmented ppes-view" role="group" aria-label="@T("Visualização", "View")">
                    <button class="@(Config.Saved.View == "grid" ? "ppes-on" : "")" title="@T("Cards", "Cards")" @onclick="@(() => SetView("grid"))"><MudIcon Icon="@Icons.Material.Filled.GridView" /></button>
                    <button class="@(Config.Saved.View == "list" ? "ppes-on" : "")" title="@T("Lista", "List")" @onclick="@(() => SetView("list"))"><MudIcon Icon="@Icons.Material.Filled.ViewList" /></button>
                    <button class="@(Config.Saved.GroupByYear ? "ppes-on" : "")" title="@T("Agrupar por ano", "Group by year")" @onclick="ToggleYears"><MudIcon Icon="@Icons.Material.Filled.Timeline" /></button>
                </div>
            </div>

            <div class="ppes-legend">
                <span><span class="ppes-tag ppes-tag-ready">@TagLabel(EventTag.Ready)</span> @T("o SPT já tem tudo, só liga", "SPT already has it, just switched on")</span>
                <span><span class="ppes-tag ppes-tag-simulated">@TagLabel(EventTag.Simulated)</span> @T("recriado com dados do servidor", "recreated from server data")</span>
                <span><span class="ppes-tag ppes-tag-experimental">@TagLabel(EventTag.Experimental)</span> @T("código antigo do jogo religado, teste antes", "old game code switched back on, test it first")</span>
            </div>

            @if (!VisiblePast.Any())
            {
                <span class="ppes-hint">@T("Nenhum evento com esses filtros.", "No events match these filters.")</span>
            }

            @foreach (var group in Groups)
            {
                @if (group.Year is { } year)
                {
                    <div class="ppes-year"><span>@year</span><span class="ppes-year-count">@group.Events.Count</span></div>
                }
                <div class="@(Config.Saved.View == "list" ? "ppes-list" : "ppes-grid")">
                    @foreach (var e in group.Events)
                    {
                        @if (Config.Saved.View == "list") { @ListRow(e) } else { @Card(e) }
                    }
                </div>
            }
        </section>
        }
        @* ---------- raid preview ---------- *@
        @if (activeSection == "raid")
        {
        <section class="ppes-section">
            <div class="ppes-section-head">
                <MudIcon Icon="@Icons.Material.Filled.Map" Class="ppes-accent" />
                <div>
                    <MudText Typo="Typo.h5">@T("Prévia da raid", "Raid preview")</MudText>
                    <MudText Typo="Typo.body2" Class="spt-muted">
                        @T("O que a próxima raid teria com a seleção atual, salva ou não, incluindo a rotação. Usa os spawns atuais do servidor, já com o ABPS e os sazonais. Em Editar, mude a chance, as zonas e a escolta, tire ou adicione chefes e facções. Suas mudanças valem depois dos eventos, a partir da próxima raid, depois de salvar.",
                           "What the next raid would have with the current picks, saved or not, rotation included. Uses the server's current spawns, ABPS and seasonal events included. In Edit, change the chance, zones and escort, or remove and add bosses and factions. Your changes apply after the events, from the next raid, once saved.")
                    </MudText>
                </div>
                <MudButton Class="ml-auto" Size="Size.Small" Variant="@(editing ? Variant.Filled : Variant.Outlined)" Color="Color.Warning"
                           StartIcon="@Icons.Material.Filled.Edit" OnClick="@(() => editing = !editing)">@(editing ? T("Concluir", "Done") : T("Editar", "Edit"))</MudButton>
            </div>
            <div class="ppes-maps" role="tablist">
                @foreach (var m in EventDetails.Maps)
                {
                    <button role="tab" aria-selected="@(previewMap == m.Id ? "true" : "false")" class="@($"{(previewMap == m.Id ? "ppes-on" : "")} {(MapTouched(m.Id) ? "ppes-map-touched" : "")}")" @onclick="@(() => SelectPreviewMap(m.Id))">@T(m.NamePt, m.NameEn)@if (working.SpawnsOf(m.Id).Count > 0){<MudIcon Icon="@Icons.Material.Filled.Edit" Class="ppes-map-edited" />}</button>
                }
            </div>
            @if (Preview is { } preview)
            {
                <MudPaper Elevation="0" Class="ppes-preview spt-panel">
                    <div class="ppes-preview-badges">
                        @if (preview.AirdropChance > 0)
                        {
                            <span class="ppes-badge"><MudIcon Icon="@Icons.Material.Filled.FlightLand" /> Airdrop @Percent(preview.AirdropChance)@(preview.AirdropMax > 1 ? T($", até {preview.AirdropMax}", $", up to {preview.AirdropMax}") : "")</span>
                        }
                        @if (preview.Mortar)
                        {
                            <span class="ppes-badge ppes-badge-hot"><MudIcon Icon="@Icons.Material.Filled.Warning" /> @T("Morteiros", "Mortars")</span>
                        }
                        @if (preview.ZombieInfection is { } infection)
                        {
                            <span class="ppes-badge ppes-badge-hot"><MudIcon Icon="@Icons.Material.Filled.Coronavirus" /> @T("Infecção zumbi", "Zombie infection") @Percent(infection)</span>
                        }
                        @if (preview.NeedsKeycard is { } keycard)
                        {
                            <span class="ppes-badge"><MudIcon Icon="@Icons.Material.Filled.VpnKey" /> @(keycard ? T("Precisa de cartão", "Keycard needed") : T("Sem cartão", "No keycard"))</span>
                        }
                    </div>
                    @if (preview.Spawns.Count == 0 && preview.Removed.Count == 0)
                    {
                        <span class="ppes-hint">@T("Nenhum chefe ou grupo especial neste mapa.", "No bosses or special groups on this map.")</span>
                    }
                    else
                    {
                        <div class="@($"ppes-table {(editing ? "ppes-table-edit" : "")}")" role="table">
                            <div class="ppes-tr ppes-th" role="row">
                                <span>@T("Quem", "Who")</span><span>@T("Chance", "Chance")</span><span>@T("Onde", "Where")</span><span>@T("Escolta", "Escort")</span>@if (editing){<span></span>}
                            </div>
                            @foreach (var s in preview.Spawns)
                            {
                                <div class="@($"ppes-tr {(s.Changed ? "ppes-tr-changed" : "")}")" role="row">
                                    <span>@T(s.NamePt, s.NameEn)@if (s.Custom){<span class="ppes-changed ppes-custom">@T("seu", "yours")</span>}else if (s.Changed){<span class="ppes-changed">@T("evento", "event")</span>}</span>
                                    @if (editing)
                                    {
                                        <input class="ppes-input ppes-cell" type="number" min="0" max="100" step="1" aria-label="@T("Chance", "Chance")" value="@s.Chance.ToString("0.#", CultureInfo.InvariantCulture)"
                                               @onchange="@(e => SetChance(s.Role, e.Value?.ToString()))" />
                                        <div class="ppes-zone-editor">
                                            <select class="ppes-input ppes-cell ppes-zone-select" value="" aria-label="@T("Adicionar região", "Add region")"
                                                    @onchange="@(e => AddZone(s.Role, e.Value?.ToString(), s.RawZones))">
                                                <option value="">@T("Adicionar região...", "Add region...")</option>
                                                @foreach (var zone in AvailableZones(s.RawZones))
                                                {
                                                    <option value="@zone">@PreviewService.ZoneLabel(zone)</option>
                                                }
                                            </select>
                                            @if (ZoneTokens(s.RawZones).Length > 0)
                                            {
                                                <div class="ppes-zone-chips" aria-label="@T("Remover zonas individualmente", "Remove zones individually")">
                                                    @foreach (var zone in ZoneTokens(s.RawZones))
                                                    {
                                                        <button class="ppes-zone-chip" type="button" title="@T($"Remover {PreviewService.ZoneLabel(zone)}", $"Remove {PreviewService.ZoneLabel(zone)}")"
                                                                aria-label="@T($"Remover região {PreviewService.ZoneLabel(zone)}", $"Remove region {PreviewService.ZoneLabel(zone)}")"
                                                                @onclick="@(() => RemoveZone(s.Role, zone, s.RawZones))">
                                                            <span>@PreviewService.ZoneLabel(zone)</span><MudIcon Icon="@Icons.Material.Filled.Close" />
                                                        </button>
                                                    }
                                                </div>
                                            }
                                        </div>
                                        <input class="ppes-input ppes-cell" aria-label="@T("Escolta", "Escort")" title="@T("Ex.: 2 ou 1-3", "E.g. 2 or 1-3")" value="@EscortValue(s)"
                                               @onchange="@(e => SetEscort(s.Role, e.Value?.ToString()))" />
                                        <span class="ppes-row-actions">
                                            @if (s.Custom)
                                            {
                                                <button class="ppes-icon-btn" title="@T("Desfazer suas mudanças", "Undo your changes")" @onclick="@(() => ResetRole(s.Role))"><MudIcon Icon="@Icons.Material.Filled.Undo" /></button>
                                            }
                                            <button class="ppes-icon-btn" title="@T("Tirar deste mapa", "Remove from this map")" @onclick="@(() => RemoveRole(s.Role))"><MudIcon Icon="@Icons.Material.Filled.Close" /></button>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="@(s.Chance >= 100 ? "ppes-sure" : "")">@($"{s.Chance:0.#}%")</span>
                                        <span class="ppes-zones">@(string.IsNullOrEmpty(s.Zones) ? T("por gatilho", "by trigger") : s.Zones)</span>
                                        <span class="ppes-escort">@EscortText(s)</span>
                                    }
                                </div>
                            }
                            @foreach (var s in preview.Removed)
                            {
                                <div class="ppes-tr ppes-tr-removed" role="row">
                                    <span>@T(s.NamePt, s.NameEn)<span class="ppes-changed ppes-custom">@T("tirado", "removed")</span></span>
                                    <span>@($"{s.Chance:0.#}%")</span>
                                    <span class="ppes-zones">@s.Zones</span>
                                    <span class="ppes-escort">@EscortText(s)</span>
                                    @if (editing)
                                    {
                                        <span class="ppes-row-actions"><button class="ppes-icon-btn" title="@T("Trazer de volta", "Bring back")" @onclick="@(() => ResetRole(s.Role))"><MudIcon Icon="@Icons.Material.Filled.Undo" /></button></span>
                                    }
                                </div>
                            }
                        </div>
                    }
                    @if (editing)
                    {
                        <div class="ppes-add-spawn">
                            <span class="ppes-label">@T("Adicionar:", "Add:")</span>
                            <select class="ppes-input" @bind="addRole" aria-label="@T("Chefe ou facção", "Boss or faction")">
                                <option value="">@T("Chefe ou facção...", "Boss or faction...")</option>
                                @foreach (var r in Previewer.AddableRoles().Where(r => preview.Spawns.All(x => !string.Equals(x.Role, r.Role, StringComparison.OrdinalIgnoreCase))))
                                {
                                    <option value="@r.Role">@T(r.NamePt, r.NameEn)</option>
                                }
                            </select>
                            <input class="ppes-input ppes-number" type="number" min="1" max="100" aria-label="@T("Chance", "Chance")" @bind="addChance" />
                            <span class="ppes-label">%</span>
                            <div class="ppes-add-zone-picker">
                                <select class="ppes-input ppes-add-zones" value="" aria-label="@T("Adicionar região", "Add region")" @onchange="@(e => AddPendingZone(e.Value?.ToString()))">
                                    <option value="">@T("Adicionar região...", "Add region...")</option>
                                    @foreach (var zone in AvailableZones(addZones))
                                    {
                                        <option value="@zone">@PreviewService.ZoneLabel(zone)</option>
                                    }
                                </select>
                                @if (ZoneTokens(addZones).Length > 0)
                                {
                                    <div class="ppes-zone-chips" aria-label="@T("Regiões selecionadas", "Selected regions")">
                                        @foreach (var zone in ZoneTokens(addZones))
                                        {
                                            <button class="ppes-zone-chip" type="button" title="@T($"Remover {PreviewService.ZoneLabel(zone)}", $"Remove {PreviewService.ZoneLabel(zone)}")"
                                                    @onclick="@(() => RemovePendingZone(zone))">
                                                <span>@PreviewService.ZoneLabel(zone)</span><MudIcon Icon="@Icons.Material.Filled.Close" />
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                            <input class="ppes-input ppes-number" placeholder="@T("Escolta", "Escort")" title="@T("Ex.: 2 ou 1-3", "E.g. 2 or 1-3")" aria-label="@T("Escolta", "Escort")" @bind="addEscort" />
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" Disabled="@string.IsNullOrEmpty(addRole)" OnClick="AddSpawn">@T("Adicionar", "Add")</MudButton>
                            @if (working.SpawnsOf(previewMap).Count > 0)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default" Class="ml-auto" OnClick="ResetMap">@T("Desfazer tudo neste mapa", "Undo all on this map")</MudButton>
                            }
                        </div>
                    }
                </MudPaper>
            }
            else if (previewError is not null)
            {
                <MudAlert Severity="Severity.Warning" Dense="true">@previewError</MudAlert>
            }
        </section>
        }

            </div>
        </div>
    </MudContainer>
</div>

@code {

    private string activeSection = "overview";
    private string settingsTab = "mechanics";
    private string selectedSeasonal = "halloween";
    private readonly HashSet<string> expandedSeasonal = [];
    private static readonly (string Id, string Pt, string En, string Icon)[] Sections =
    [
        ("overview", "Vis\u00e3o geral", "Overview", Icons.Material.Filled.Dashboard),
        ("seasonal", "Eventos sazonais", "Seasonal events", Icons.Material.Filled.Event),
        ("events", "Eventos antigos", "Past events", Icons.Material.Filled.History),
        ("raid", "Configurar raid", "Raid setup", Icons.Material.Filled.Map),
        ("settings", "Configura\u00e7\u00f5es", "Settings", Icons.Material.Filled.Tune),
    ];
    private static readonly (string Id, string Pt, string En)[] SettingsTabs =
    [
        ("mechanics", "Mec\u00e2nicas", "Mechanics"),
        ("rotation", "Rota\u00e7\u00e3o", "Rotation"),
        ("presets", "Presets", "Presets"),
        ("notice", "Aviso no jogo", "In-game notice"),
    ];
    private void OpenSettings(string tab) { settingsTab = tab; activeSection = "settings"; }
    private void OpenSeasonal(string id) { selectedSeasonal = id; activeSection = "seasonal"; }
    private void ToggleSeasonalDetails(string id)
    {
        if (!expandedSeasonal.Add(id)) expandedSeasonal.Remove(id);
    }

    private RenderFragment SeasonalOption(PartDef part) => builder =>
    {
        var partOn = GetPart(part.Key);
        var waitingForZombies = part.Key is "h.labonly" or "h.waves" && !working.Halloween.ZombiesOn;

        RenderFragment content = @<text>
                                    <label class="@($"ppes-part {(waitingForZombies ? "ppes-part-waiting" : "")}")">
                                        <input type="checkbox" checked="@partOn" @onchange="@(e => SetPart(part.Key, e.Value is true))" />
                                        <span class="ppes-part-copy">
                                            <span class="ppes-part-name">@T(part.Pt, part.En)</span>
                                            <span class="ppes-part-hint">@T(part.PtHint, part.EnHint)</span>
                                            @if (waitingForZombies)
                                            {
                                                <span class="ppes-part-dependency">@T("Aguardando: ligue Zumbis e infectados ou Surto de 2026.", "Waiting: enable Zombies and infected or 2026 outbreak.")</span>
                                            }
                                        </span>
                                    </label>
                                    @if (part.Key == "h.waves" && partOn)
                                    {
                                        <div class="ppes-wave-settings">
                                            <span class="ppes-wave-title">@T("Aleatório quando o mínimo e o máximo são diferentes", "Random when minimum and maximum differ")</span>
                                            <label>
                                                <span>@T("Zumbis por onda", "Zombies per wave")</span>
                                                <span class="ppes-wave-range">
                                                    <input class="ppes-input ppes-number" type="number" min="1" max="20" value="@working.Halloween.ZombieWaveSizeMin" @onchange="@(e => SetZombieWaveNumber("sizeMin", e.Value?.ToString()))" />
                                                    <span>@T("até", "to")</span>
                                                    <input class="ppes-input ppes-number" type="number" min="1" max="20" value="@working.Halloween.ZombieWaveSizeMax" @onchange="@(e => SetZombieWaveNumber("sizeMax", e.Value?.ToString()))" />
                                                </span>
                                            </label>
                                            <label>
                                                <span>@T("Minutos entre ondas", "Minutes between waves")</span>
                                                <span class="ppes-wave-range">
                                                    <input class="ppes-input ppes-number" type="number" min="1" max="30" value="@working.Halloween.ZombieWaveIntervalMin" @onchange="@(e => SetZombieWaveNumber("intervalMin", e.Value?.ToString()))" />
                                                    <span>@T("até", "to")</span>
                                                    <input class="ppes-input ppes-number" type="number" min="1" max="30" value="@working.Halloween.ZombieWaveIntervalMax" @onchange="@(e => SetZombieWaveNumber("intervalMax", e.Value?.ToString()))" />
                                                </span>
                                            </label>
                                        </div>
                                    }

        </text>;
        content(builder);
    };

    private static readonly (string Value, string Pt, string En)[] Modes =
    [
        (SeasonalMode.Auto, "Automático", "Auto"),
        (SeasonalMode.On, "Ligado", "On"),
        (SeasonalMode.Off, "Desligado", "Off"),
