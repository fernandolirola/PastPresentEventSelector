    /// <summary>Differences between what is saved and what the server applied at startup that only a restart fixes.</summary>
    private List<string> PendingRestart
    {
        get
        {
            var saved = Config.Saved;
            var applied = Config.Applied;
            var names = EventCatalog.Seasonal
                .Where(s => IsSeasonalActive(saved, s.Id) != IsSeasonalActive(applied, s.Id))
                .Select(s => T(s.NamePt, s.NameEn))
                .ToList();
            if (IsSeasonalActive(saved, "halloween") && !saved.Halloween.SameServerSettingsAs(applied.Halloween))
                names.Add(T("Partes do Halloween", "Halloween parts"));
            if ((IsSeasonalActive(saved, "christmas") || IsSeasonalActive(saved, "newyears")) && !saved.Christmas.SameAs(applied.Christmas))
                names.Add(T("Partes do Natal e Ano Novo", "Christmas and New Year parts"));
            if (IsSeasonalActive(saved, "aprilfools") && !saved.AprilFools.SameAs(applied.AprilFools))
                names.Add(T("Partes do 1º de abril", "April Fools parts"));
            if (saved.Mechanics.RitualExitTime != applied.Mechanics.RitualExitTime
                || saved.Mechanics.RitualStamina != applied.Mechanics.RitualStamina
                || saved.Mechanics.ToxinHydration != applied.Mechanics.ToxinHydration
                || saved.Mechanics.ToxinHearing != applied.Mechanics.ToxinHearing)
                names.Add(T("Efeitos do ritual e da infec\u00e7\u00e3o", "Ritual and infection effects"));
            if (!saved.SeasonalRotation.SameAs(applied.SeasonalRotation))
                names.Add(T("Rota\u00e7\u00e3o dos sazonais", "Seasonal rotation"));
            names.AddRange(EventCatalog.PastEvents
                .Where(e => e.NeedsRestart && saved.HasEvent(e.Id) != applied.HasEvent(e.Id))
                .Select(e => e.Name));
            return names;
        }
    }

    private RaidPreview? Preview
    {
        get
        {
            var events = EventSchedule.RaidEvents(working, Now).Concat(working.Events.Where(id => id is "mortarStrike" or "freeLabs" or "softcore")).Distinct().ToList();
            var edits = working.SpawnsOf(previewMap);
            var h = working.Halloween;
            var key = previewMap + "|" + string.Join(",", events) + "|" + string.Join(";", edits.Select(e => $"{e.Role}:{e.Remove}:{e.Chance}:{e.Zones}:{e.Escort}"))
                + $"|h:{IsSeasonalActive(working, "halloween")}:{h.FreeLab}:{h.ZombiesOn}:{h.ZombieWaves}:{h.ZombieWaveSizeMin}:{h.ZombieWaveSizeMax}:{h.ZombieWaveIntervalMin}:{h.ZombieWaveIntervalMax}:{h.Outbreak2026}";
            if (previewCache is { } cached && cached.Key == key) return cached.Value;
            try
            {
                var value = Previewer.Preview(previewMap, events, edits, working);
                previewCache = (key, value);
                previewError = null;
                return value;
            }
            catch (Exception ex)
            {
                previewError = T("Não foi possível gerar a prévia: ", "Could not build the preview: ") + ex.Message;
                return null;
            }
        }
    }

    protected override void OnInitialized()
    {
        Discard();
        Config.Changed += OnConfigChanged;
    }

    private void OnConfigChanged() => InvokeAsync(() =>
    {
        if (!savingDraft)
        {
            if (!IsDirty) Discard();
            else draftConflict = !Config.Saved.SameSelectionAs(draftBaseline);
        }
        previewCache = null;
        StateHasChanged();
    });

    public void Dispose() => Config.Changed -= OnConfigChanged;

    // the applied config was picked for the day the server started; anything else is judged for today
    private bool IsSeasonalActive(PpesConfig config, string id) =>
        EventSchedule.SeasonalActive(config, Calendar, id, ReferenceEquals(config, Config.Applied) ? Config.StartedAt.Date : Today);

