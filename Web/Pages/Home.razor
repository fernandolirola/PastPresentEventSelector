    private bool MapTouched(string mapId) => EventSchedule.RaidEvents(working, Now).Concat(working.Events).Any(id => EventDetails.Of(id).Maps.Contains(mapId));

    private void Toggle(PastEventDef e, bool on)
    {
        working.Events.RemoveAll(x => string.Equals(x, e.Id, StringComparison.OrdinalIgnoreCase));
        if (!on) return;
        foreach (var other in GroupMates(e).Where(o => working.HasEvent(o.Id)).ToList())
        {
            working.Events.RemoveAll(x => string.Equals(x, other.Id, StringComparison.OrdinalIgnoreCase));
            Snackbar.Add(T($"{other.Name} foi desligado: não combina com {e.Name}.", $"{other.Name} was turned off: it can't run with {e.Name}."), Severity.Info);
        }
        working.Events.Add(e.Id);
        foreach (var miss in MissingNeeds(e))
            Snackbar.Add(miss.Need.Partial
                ? T($"{miss.Mod.Name} não está instalado: {e.Name} roda sem {miss.Need.LostPt}.", $"{miss.Mod.Name} is not installed: {e.Name} runs without {miss.Need.LostEn}.")
                : T($"{miss.Mod.Name} não está instalado: {e.Name} não vai fazer nada.", $"{miss.Mod.Name} is not installed: {e.Name} will do nothing."),
                Severity.Warning);
    }

    private static List<(ModRequirement Mod, ModNeed Need)> MissingNeeds(PastEventDef e) =>
        e.AllNeeds.Where(n => !ModRequirements.IsInstalled(n.Mod)).Select(n => (ModRequirements.Get(n.Mod), n)).ToList();

    private static IEnumerable<PastEventDef> GroupMates(PastEventDef e) =>
        e.Group is null ? [] : EventCatalog.PastEvents.Where(o => o.Group == e.Group && o.Id != e.Id);

    /// <summary>Other picked events changing the same thing, outside an exclusive group (those are handled by Toggle).</summary>
    private List<(string Touch, List<string> Events)> Overlaps(PastEventDef e)
    {
        if (!working.HasEvent(e.Id)) return [];
        var mates = GroupMates(e).Select(m => m.Id).ToHashSet();
        return EventDetails.Of(e.Id).Touches
            .Select(t => (t, working.Events.Where(id => id != e.Id && !mates.Contains(id) && EventDetails.Of(id).Touches.Contains(t)).Select(id => EventCatalog.Past(id)!.Name).ToList()))
            .Where(x => x.Item2.Count > 0)
            .ToList();
    }

    private void Save()
    {
        try
        {
            savingDraft = true;
            if (!Config.TrySaveDraft(working, draftBaseline))
            {
                draftConflict = true;
                return;
            }
            Discard();
            Snackbar.Add(PendingRestart.Count > 0 ? T("Salvo. Reinicie o servidor para aplicar tudo.", "Saved. Restart the server to apply everything.") : T("Salvo.", "Saved."), Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(T("Não foi possível salvar: ", "Could not save: ") + ex.Message, Severity.Error);
        }
        finally { savingDraft = false; }
    }

    private void Discard()
    {
        working = Config.Saved.Clone();
        draftBaseline = working.Clone();
        draftConflict = false;
        previewCache = null;
        addRole = addZones = addEscort = "";
        addChance = 100;
    }

