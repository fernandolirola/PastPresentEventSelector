@page "/ppes"
@attribute [Authorize(Policy = "Administrator")]
@layout BaseMudBlazorLayout
@implements IDisposable
@inject ConfigService Config
@inject SeasonalCalendar Calendar
@inject CompatibilityService Compat
@inject QuestAvailability QuestCheck
@inject PreviewService Previewer
@inject ISnackbar Snackbar

<PageTitle>Past &amp; Present Event Selector</PageTitle>

<HeadContent>
    <link href="/PastPresentEventSelector/css/ppes.css" rel="stylesheet" />
</HeadContent>

<div class="ppes-page spt-page">
    <MudContainer MaxWidth="MaxWidth.False" Class="ppes-container pa-6">

        <MudPaper Elevation="0" Class="ppes-hero spt-panel pa-5">
            <div class="ppes-hero-copy">
                <MudText Typo="Typo.overline" Class="spt-kicker">zezinho's</MudText>
                <MudText Typo="Typo.h3" Class="spt-title">Past &amp; Present Event Selector</MudText>
                <MudText Typo="Typo.body2" Class="spt-subtitle mt-1">
                    @T("Escolha quais eventos ficam ativos. Os sazonais seguem a data sozinhos, mas você pode ligar ou desligar qualquer um. Os eventos antigos foram recriados com os dados do servidor.",
                       "Pick which events are active. Seasonal events follow the date on their own, but you can switch any of them on or off. Past events are recreated from server data.")
                </MudText>
            </div>
            <div class="ppes-hero-actions">
                <div class="ppes-lang" role="group" aria-label="Language">
                    <button class="@(IsPt ? "" : "ppes-on")" @onclick="@(() => SetLanguage("en"))" title="English">EN</button>
                    <button class="@(IsPt ? "ppes-on" : "")" @onclick="@(() => SetLanguage("pt"))" title="Português">PT</button>
                </div>
                <div class="ppes-save-row">
                    @if (IsDirty)
                    {
                        <span class="ppes-dirty"><MudIcon Icon="@Icons.Material.Filled.Circle" Size="Size.Small" /> @T("Alterações não salvas", "Unsaved changes")</span>
                        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="Discard">@T("Descartar", "Discard")</MudButton>
                    }
                    <MudButton Variant="Variant.Filled" Color="Color.Warning" Disabled="@(!IsDirty)" StartIcon="@Icons.Material.Filled.Save" OnClick="Save">@T("Salvar", "Save")</MudButton>
                </div>
            </div>
        </MudPaper>

        @if (PendingRestart.Count > 0)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                @T("Reinicie o servidor para aplicar: ", "Restart the server to apply: ")<strong>@string.Join(", ", PendingRestart)</strong>.
                @T(" Eventos de boss e de airdrop valem já na próxima raid.", " Boss and airdrop events already apply from the next raid.")
            </MudAlert>
        }

        @foreach (var note in Compat.Notes)
        {
            <MudAlert Severity="@(note.Warning ? Severity.Warning : Severity.Info)" Dense="true">@T(note.Pt, note.En)</MudAlert>
        }

        @* ---------- seasonal ---------- *@
        <section class="ppes-section">
            <div class="ppes-section-head">
                <MudIcon Icon="@Icons.Material.Filled.Event" Class="ppes-accent" />
                <div>
                    <MudText Typo="Typo.h5">@T("Eventos sazonais", "Seasonal events")</MudText>
                    <MudText Typo="Typo.body2" Class="spt-muted">
                        @T($"Hoje é {FormatDate(Today)}. No modo Automático, o evento liga sozinho nas datas dele.", $"Today is {FormatDate(Today)}. In Auto mode an event turns on by itself during its dates.")
                    </MudText>
                </div>
            </div>

            @if (EffectiveSeasonal.Count > 1)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                    @T("Mais de um evento sazonal ligado. O SPT aplica todos, mas as quests e itens de evento seguem só o último da lista. Pode haver efeitos estranhos.",
                       "More than one seasonal event is on. SPT applies them all, but event quests and items only follow the last one in the list. Expect some odd results.")
                </MudAlert>
            }

            <div class="ppes-grid ppes-grid-seasonal">
                @foreach (var s in EventCatalog.Seasonal)
                {
                    var mode = working.ModeOf(s.Id);
                    var active = IsSeasonalActive(working, s.Id);
                    <MudPaper Elevation="0" Class="@($"ppes-card spt-panel {(active ? "ppes-card-on" : "")}")">
                        <div class="ppes-card-head">
                            <div>
                                <MudText Typo="Typo.h6">@T(s.NamePt, s.NameEn)</MudText>
                                <span class="ppes-meta">@WindowText(s.Id)@WikiLink(s.Id)</span>
                            </div>
                            <span class="@($"ppes-status {(active ? "ppes-status-on" : "")}")">@(active ? T("Ativo", "Active") : T("Desligado", "Off"))</span>
                        </div>
                        <MudText Typo="Typo.body2" Class="spt-muted">@T(s.DescPt, s.DescEn)</MudText>
                        <div class="ppes-segmented" role="radiogroup">
                            @foreach (var (value, pt, en) in Modes)
                            {
                                <button role="radio" aria-checked="@(mode == value)" class="@(mode == value ? "ppes-on" : "")" @onclick="@(() => SetMode(s.Id, value))">@T(pt, en)</button>
                            }
                        </div>
                        @if (PartsOf(s.Id) is { Count: > 0 } partList)
                        {
                            <div class="@($"ppes-parts {(active ? "" : "ppes-parts-off")}")">
                                <span class="ppes-label">@PartsTitle(s.Id)</span>
                                @foreach (var part in partList)
                                {
                                    var partOn = GetPart(part.Key);
                                    <label class="ppes-part" title="@T(part.PtHint, part.EnHint)">
                                        <input type="checkbox" checked="@partOn" @onchange="@(e => SetPart(part.Key, e.Value is true))" />
                                        <span>@T(part.Pt, part.En)</span>
                                    </label>
                                }
                            </div>
                        }
                        <div class="ppes-card-foot">
                            <span class="ppes-hint">@SeasonalHint(s.Id, mode)</span>
                            @QuestInfo(EventCatalog.SeasonalQuests(s.Id))
                        </div>
                    </MudPaper>
                }
            </div>
        </section>

        @* ---------- presets, rotation, message ---------- *@
        <section class="ppes-tools">
            <MudPaper Elevation="0" Class="ppes-panel spt-panel">
                <div class="ppes-panel-head">
                    <MudIcon Icon="@Icons.Material.Filled.Bookmarks" Class="ppes-accent" />
                    <MudText Typo="Typo.h6">@T("Presets", "Presets")</MudText>
                </div>
                <MudText Typo="Typo.body2" Class="spt-muted">@T("Aplica um conjunto de eventos. Depois é só salvar.", "Applies a set of events. Then just save.")</MudText>
                <div class="ppes-chips">
                    @foreach (var p in EventDetails.Presets)
                    {
                        <button class="ppes-chip" title="@T(p.DescPt, p.DescEn)" @onclick="@(() => ApplyPreset(p.Events, p.Id == "vanilla" ? AllAuto() : null))">@T(p.NamePt, p.NameEn)</button>
                    }
                    @foreach (var (name, preset) in Config.Saved.Presets)
                    {
                        <span class="ppes-chip ppes-chip-custom">
                            <button @onclick="@(() => ApplyPreset(preset.Events, preset.Seasonal))">@name</button>
                            <button class="ppes-chip-x" title="@T("Apagar preset", "Delete preset")" @onclick="@(() => DeletePreset(name))">×</button>
                        </span>
                    }
                </div>
                <div class="ppes-inline-form">
                    <input class="ppes-input" placeholder="@T("Nome do seu preset", "Your preset name")" maxlength="40" @bind="presetName" @bind:event="oninput" />
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" Disabled="@string.IsNullOrWhiteSpace(presetName)" OnClick="SavePreset">@T("Salvar seleção atual", "Save current picks")</MudButton>
                </div>
            </MudPaper>

            <MudPaper Elevation="0" Class="ppes-panel spt-panel">
                <div class="ppes-panel-head">
                    <MudIcon Icon="@Icons.Material.Filled.Autorenew" Class="ppes-accent" />
                    <MudText Typo="Typo.h6">@T("Rotação automática", "Automatic rotation")</MudText>
                </div>
                <MudText Typo="Typo.body2" Class="spt-muted">@T("O servidor sorteia eventos sozinho e liga pra você, toda semana ou só nos fins de semana, como os eventos de fim de semana do jogo. Eles somam com os que você ligou e trocam sozinhos. Só entram no sorteio eventos que valem na próxima raid, então não precisa reiniciar.", "The server draws events by itself and turns them on for you, every week or only on weekends, like the live weekend events. They add to the ones you turned on and change on their own. Only events that apply from the next raid are drawn, so no restart is needed.")</MudText>
                <div class="ppes-row">
                    <span class="ppes-label">@T("Sortear:", "Draw:")</span>
                    <div class="ppes-segmented" role="radiogroup">
                        @foreach (var (value, pt, en) in RotationModes)
                        {
                            <button role="radio" aria-checked="@(working.Rotation.Mode == value)" class="@(working.Rotation.Mode == value ? "ppes-on" : "")" @onclick="@(() => working.Rotation.Mode = value)">@T(pt, en)</button>
                        }
                    </div>
                    @if (working.Rotation.Mode != RotationMode.Off)
                    {
                        <span class="ppes-label">@T("Quantos:", "How many:")</span>
                        <input class="ppes-input ppes-number" type="number" min="1" max="@RotationMax" aria-label="@T("Quantidade", "Amount")"
                               value="@working.Rotation.Count" @onchange="@(e => working.Rotation.Count = Math.Clamp(int.TryParse(e.Value?.ToString(), out var n) ? n : 1, 1, RotationMax))" />
                        <span class="ppes-label">@T($"de {RotationMax}", $"of {RotationMax}")</span>
                    }
                </div>
                @if (working.Rotation.Mode != RotationMode.Off)
                {
                    var rotation = EventSchedule.Rotation(working, Now);
                    <div class="ppes-rotation">
                        <span class="ppes-hint">
                            @(rotation.Active
                                ? T($"Sorteados agora, ligados até {FormatDate(rotation.Until.AddDays(-1))}:", $"Drawn now, on until {FormatDate(rotation.Until.AddDays(-1))}:")
                                : T($"Sorteio do próximo fim de semana ({FormatDate(rotation.From)} e {FormatDate(rotation.From.AddDays(1))}):", $"Next weekend's draw ({FormatDate(rotation.From)} and {FormatDate(rotation.From.AddDays(1))}):"))
                        </span>
                        @foreach (var id in rotation.Picks)
                        {
                            <span class="@($"ppes-pill {(rotation.Active ? "ppes-pill-on" : "")}")">@EventCatalog.Past(id)?.Name</span>
                        }
                    </div>
                }
            </MudPaper>

            <MudPaper Elevation="0" Class="ppes-panel spt-panel">
                <div class="ppes-panel-head">
                    <MudIcon Icon="@Icons.Material.Filled.Mail" Class="ppes-accent" />
                    <MudText Typo="Typo.h6">@T("Aviso no jogo", "In-game notice")</MudText>
                    <MudSwitch T="bool" Value="@working.TraderMessage" ValueChanged="@(v => working.TraderMessage = v)" Color="Color.Warning" Class="ml-auto" aria-label="@T("Aviso no jogo", "In-game notice")" />
                </div>
                <MudText Typo="Typo.body2" Class="spt-muted">
                    @T("Quando você entra no jogo, o Fence manda uma mensagem com os boatos dos eventos ativos. Só manda de novo quando os eventos mudam.",
                       "When you log in, Fence sends a message with rumors about the active events. It only sends again when the events change.")
                </MudText>
            </MudPaper>
        </section>

        @* ---------- past events ---------- *@
        <section class="ppes-section">
            <div class="ppes-section-head">
                <MudIcon Icon="@Icons.Material.Filled.History" Class="ppes-accent" />
                <div>
                    <MudText Typo="Typo.h5">@T("Eventos antigos", "Past events")</MudText>
                    <MudText Typo="Typo.body2" Class="spt-muted">
                        @T($"{working.Events.Count} de {EventCatalog.PastEvents.Count} ligados.", $"{working.Events.Count} of {EventCatalog.PastEvents.Count} on.")
                    </MudText>
                </div>
            </div>

            <div class="ppes-toolbar">
                <input class="ppes-input ppes-search" type="search" placeholder="@T("Buscar evento...", "Search events...")" @bind="search" @bind:event="oninput" />
                <select class="ppes-input" @bind="mapFilter" aria-label="@T("Mapa", "Map")">
                    <option value="">@T("Todos os mapas", "All maps")</option>
                    @foreach (var m in EventDetails.Maps)
                    {
                        <option value="@m.Id">@T(m.NamePt, m.NameEn)</option>
                    }
                </select>
                <select class="ppes-input" @bind="kindFilter" aria-label="@T("Tipo", "Type")">
                    <option value="">@T("Todos os tipos", "All types")</option>
                    @foreach (var k in KindList)
                    {
                        <option value="@k.ToString()">@KindLabel(k)</option>
                    }
                </select>
                <div class="ppes-filters">
                    @foreach (var (value, pt, en) in Filters)
                    {
                        <button class="@(filter == value ? "ppes-on" : "")" @onclick="@(() => filter = value)">@T(pt, en)</button>
                    }
                </div>
                <div class="ppes-segmented ppes-view" role="group" aria-label="@T("Visualização", "View")">
                    <button class="@(Config.Saved.View == "grid" ? "ppes-on" : "")" title="@T("Cards", "Cards")" @onclick="@(() => SetView("grid"))"><MudIcon Icon="@Icons.Material.Filled.GridView" /></button>
                    <button class="@(Config.Saved.View == "list" ? "ppes-on" : "")" title="@T("Lista", "List")" @onclick="@(() => SetView("list"))"><MudIcon Icon="@Icons.Material.Filled.ViewList" /></button>
                    <button class="@(Config.Saved.GroupByYear ? "ppes-on" : "")" title="@T("Agrupar por ano", "Group by year")" @onclick="ToggleYears"><MudIcon Icon="@Icons.Material.Filled.Timeline" /></button>
                </div>
            </div>

            <div class="ppes-legend">
                <span><span class="ppes-tag ppes-tag-ready">@TagLabel(EventTag.Ready)</span> @T("o SPT já tem tudo, só liga", "SPT already has it, just switched on")</span>
                <span><span class="ppes-tag ppes-tag-simulated">@TagLabel(EventTag.Simulated)</span> @T("recriado com dados do servidor", "recreated from server data")</span>
                <span><span class="ppes-tag ppes-tag-experimental">@TagLabel(EventTag.Experimental)</span> @T("código antigo do jogo religado, teste antes", "old game code switched back on, test it first")</span>
            </div>

            @if (!VisiblePast.Any())
            {
                <span class="ppes-hint">@T("Nenhum evento com esses filtros.", "No events match these filters.")</span>
            }

            @foreach (var group in Groups)
            {
                @if (group.Year is { } year)
                {
                    <div class="ppes-year"><span>@year</span><span class="ppes-year-count">@group.Events.Count</span></div>
                }
                <div class="@(Config.Saved.View == "list" ? "ppes-list" : "ppes-grid")">
                    @foreach (var e in group.Events)
                    {
                        @if (Config.Saved.View == "list") { @ListRow(e) } else { @Card(e) }
                    }
                </div>
            }
        </section>
        @* ---------- raid preview ---------- *@
        <section class="ppes-section">
            <div class="ppes-section-head">
                <MudIcon Icon="@Icons.Material.Filled.Map" Class="ppes-accent" />
                <div>
                    <MudText Typo="Typo.h5">@T("Prévia da raid", "Raid preview")</MudText>
                    <MudText Typo="Typo.body2" Class="spt-muted">
                        @T("O que a próxima raid teria com a seleção atual, salva ou não, incluindo a rotação. Usa os spawns atuais do servidor, já com o ABPS e os sazonais.",
                           "What the next raid would have with the current picks, saved or not, rotation included. Uses the server's current spawns, ABPS and seasonal events included.")
                    </MudText>
                </div>
            </div>
            <div class="ppes-maps" role="tablist">
                @foreach (var m in EventDetails.Maps)
                {
                    <button role="tab" aria-selected="@(previewMap == m.Id)" class="@($"{(previewMap == m.Id ? "ppes-on" : "")} {(MapTouched(m.Id) ? "ppes-map-touched" : "")}")" @onclick="@(() => previewMap = m.Id)">@T(m.NamePt, m.NameEn)</button>
                }
            </div>
            @if (Preview is { } preview)
            {
                <MudPaper Elevation="0" Class="ppes-preview spt-panel">
                    <div class="ppes-preview-badges">
                        @if (preview.AirdropChance > 0)
                        {
                            <span class="ppes-badge"><MudIcon Icon="@Icons.Material.Filled.FlightLand" /> Airdrop @Percent(preview.AirdropChance)@(preview.AirdropMax > 1 ? T($", até {preview.AirdropMax}", $", up to {preview.AirdropMax}") : "")</span>
                        }
                        @if (preview.Mortar)
                        {
                            <span class="ppes-badge ppes-badge-hot"><MudIcon Icon="@Icons.Material.Filled.Warning" /> @T("Morteiros", "Mortars")</span>
                        }
                        @if (preview.NeedsKeycard is { } keycard)
                        {
                            <span class="ppes-badge"><MudIcon Icon="@Icons.Material.Filled.VpnKey" /> @(keycard ? T("Precisa de cartão", "Keycard needed") : T("Sem cartão", "No keycard"))</span>
                        }
                    </div>
                    @if (preview.Spawns.Count == 0)
                    {
                        <span class="ppes-hint">@T("Nenhum chefe ou grupo especial neste mapa.", "No bosses or special groups on this map.")</span>
                    }
                    else
                    {
                        <div class="ppes-table" role="table">
                            <div class="ppes-tr ppes-th" role="row">
                                <span>@T("Quem", "Who")</span><span>@T("Chance", "Chance")</span><span>@T("Onde", "Where")</span><span>@T("Escolta", "Escort")</span>
                            </div>
                            @foreach (var s in preview.Spawns)
                            {
                                <div class="@($"ppes-tr {(s.Changed ? "ppes-tr-changed" : "")}")" role="row">
                                    <span>@T(s.NamePt, s.NameEn)@(s.Groups > 1 ? $" ×{s.Groups}" : "")@if (s.Changed){<span class="ppes-changed">@T("evento", "event")</span>}</span>
                                    <span class="@(s.Chance >= 100 ? "ppes-sure" : "")">@($"{s.Chance:0}%")</span>
                                    <span class="ppes-zones">@(string.IsNullOrEmpty(s.Zones) ? T("por gatilho", "by trigger") : s.Zones)</span>
                                    <span class="ppes-escort">@EscortText(s)</span>
                                </div>
                            }
                        </div>
                    }
                </MudPaper>
            }
            else if (previewError is not null)
            {
                <MudAlert Severity="Severity.Warning" Dense="true">@previewError</MudAlert>
            }
        </section>

    </MudContainer>
</div>

@code {
    private static readonly (string Value, string Pt, string En)[] Modes =
    [
        (SeasonalMode.Auto, "Automático", "Auto"),
        (SeasonalMode.On, "Ligado", "On"),
        (SeasonalMode.Off, "Desligado", "Off"),
    ];

    private static readonly (string Value, string Pt, string En)[] RotationModes =
    [
        (RotationMode.Off, "Desligada", "Off"),
        (RotationMode.Weekly, "Semanal", "Weekly"),
        (RotationMode.Weekend, "Fins de semana", "Weekends"),
    ];

    private static readonly (string Value, string Pt, string En)[] Filters =
    [
        ("all", "Todos", "All"),
        ("on", "Ligados", "On"),
        ("Ready", "Prontos", "Ready"),
        ("Simulated", "Simulados", "Simulated"),
        ("Experimental", "Experimentais", "Experimental"),
    ];

    private static readonly EventKind[] KindList =
        [EventKind.Bosses, EventKind.Quests, EventKind.Traders, EventKind.Flea, EventKind.Airdrops, EventKind.Hideout, EventKind.Rules, EventKind.Access, EventKind.Hazard];

    private static int RotationMax => EventSchedule.RotationPool.Count();

    private static readonly string[] MonthsEn = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
    private static readonly string[] MonthsPt = ["jan", "fev", "mar", "abr", "mai", "jun", "jul", "ago", "set", "out", "nov", "dez"];

    private PpesConfig working = new();
    private string filter = "all";
    private string search = "";
    private string mapFilter = "";
    private string kindFilter = "";
    private string presetName = "";
    private string previewMap = "bigmap";
    private string? previewError;
    private (string Key, RaidPreview Value)? previewCache;

    private bool IsPt => Config.Saved.Language == "pt";
    private string T(string pt, string en) => IsPt ? pt : en;
    private static DateTime Now => DateTimeOffset.Now.DateTime;
    private static DateTime Today => Now.Date;

    private bool IsDirty =>
        !working.Events.SequenceEqual(Config.Saved.Events, StringComparer.OrdinalIgnoreCase)
        || EventCatalog.Seasonal.Any(s => working.ModeOf(s.Id) != Config.Saved.ModeOf(s.Id))
        || working.Rotation.Mode != Config.Saved.Rotation.Mode
        || working.Rotation.Count != Config.Saved.Rotation.Count
        || working.TraderMessage != Config.Saved.TraderMessage
        || !working.Halloween.SameAs(Config.Saved.Halloween)
        || !working.Christmas.SameAs(Config.Saved.Christmas)
        || !working.AprilFools.SameAs(Config.Saved.AprilFools);

    private sealed record PartDef(string Key, string Pt, string En, string PtHint, string EnHint);

    private static readonly IReadOnlyList<PartDef> HalloweenPartList =
    [
        new("h.ritual", "Ritual do Zryachiy (2023)", "Zryachiy ritual (2023)",
            "Zryachiy andando pelos mapas. Matar ele começa o ritual dos sacerdotes; se o ritual terminar, aparece o Zryachiy Vingativo (Mstyaschiy).",
            "Zryachiy roams the maps. Killing him starts the priests' ritual; if it finishes, Vengeful Zryachiy (Mstyaschiy) appears."),
        new("h.zombies", "Zumbis e infectados (2024)", "Zombies and infected (2024)",
            "Infectados nos mapas e a barra de infecção. O SPT deixa desligado por padrão porque fica muito difícil.",
            "Infected on the maps and the infection meter. SPT ships it off because it gets very hard."),
        new("h.cultists", "Noite dos cultistas (2025)", "Night of the cult (2025)",
            "Os cultistas especiais Oni, Harbinger e Ghost onde ficam os Goons.",
            "The special cultists Oni, Harbinger and Ghost where the Goons roam."),
        new("h.labonly", "Lab só com infectados (com zumbis)", "Lab with infected only (with zombies)",
            "Com os zumbis ligados, a Lab fica sem os Raiders e os chefes normais, só infectados, como no SPT original.",
            "With zombies on, the Lab loses its Raiders and usual bosses and only has infected, as in stock SPT."),
        new("h.freelab", "Lab sem cartão", "Lab without keycard",
            "Durante o Halloween, entrar na Lab não precisa de cartão.",
            "During Halloween, entering the Lab needs no keycard."),
    ];

    private static readonly IReadOnlyList<PartDef> AprilFoolsPartList =
    [
        new("a.winter", "Clima de inverno", "Winter weather",
            "Neve nos mapas no 1º de abril.",
            "Snow on the maps on April Fools."),
        new("a.santa", "Papai Noel nos mapas", "Santa on the maps",
            "O Papai Noel anda pelos mapas e dá presentes.",
            "Santa walks the maps handing out gifts."),
        new("a.ritual", "Ritual e cultistas", "Ritual and cultists",
            "O ritual do Zryachiy e os cultistas especiais do Halloween.",
            "The Zryachiy ritual and the special Halloween cultists."),
    ];

    private static readonly IReadOnlyList<PartDef> ChristmasPartList =
    [
        new("c.santa", "Papai Noel nos mapas (2021)", "Santa on the maps (2021)",
            "O Papai Noel anda pelos mapas e dá presentes. Não atire nele.",
            "Santa walks the maps handing out gifts. Don't shoot him."),
        new("c.hideout", "Árvore no hideout", "Hideout tree",
            "Árvore de Natal e decoração no hideout.",
            "Christmas tree and decorations in the hideout."),
        new("c.khorovod", "Khorovod (2024)", "Khorovod (2024)",
            "O evento da árvore nos mapas: abasteça o gerador, defenda a árvore e veja os bots dançando em volta dela.",
            "The tree event on the maps: refuel the generator, defend the tree and watch the bots dance around it."),
