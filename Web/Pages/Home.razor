    private List<string> EffectiveSeasonal => EventCatalog.Seasonal.Where(s => IsSeasonalActive(working, s.Id)).Select(s => s.Id).ToList();

    private IEnumerable<PastEventDef> VisiblePast => EventCatalog.PastEvents.Where(e =>
        (filter switch
        {
            "all" => true,
            "on" => working.HasEvent(e.Id),
            _ => e.Tag.ToString() == filter,
        })
        && (mapFilter == "" || EventDetails.Of(e.Id).Maps.Contains(mapFilter))
        && (kindFilter == "" || (Enum.TryParse<EventKind>(kindFilter, out var kind) && EventDetails.KindsOf(e).HasFlag(kind)))
        && (search.Trim() == "" || e.Name.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase)
            || e.DescEn.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase) || e.DescPt.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase)));

    private sealed record EventGroup(int? Year, List<PastEventDef> Events);

    private IEnumerable<EventGroup> Groups => Config.Saved.GroupByYear
        ? VisiblePast.GroupBy(EventDetails.YearOf).OrderByDescending(g => g.Key).Select(g => new EventGroup(g.Key, g.ToList()))
        : [new EventGroup(null, VisiblePast.ToList())];

    /// <summary>Differences between what is saved and what the server applied at startup that only a restart fixes.</summary>
    private List<string> PendingRestart
    {
        get
        {
            var saved = Config.Saved;
            var applied = Config.Applied;
            var names = EventCatalog.Seasonal
                .Where(s => IsSeasonalActive(saved, s.Id) != IsSeasonalActive(applied, s.Id))
                .Select(s => T(s.NamePt, s.NameEn))
                .ToList();
            if (IsSeasonalActive(saved, "halloween") && !saved.Halloween.SameAs(applied.Halloween))
                names.Add(T("Partes do Halloween", "Halloween parts"));
            if ((IsSeasonalActive(saved, "christmas") || IsSeasonalActive(saved, "newyears")) && !saved.Christmas.SameAs(applied.Christmas))
                names.Add(T("Partes do Natal e Ano Novo", "Christmas and New Year parts"));
            if (IsSeasonalActive(saved, "aprilfools") && !saved.AprilFools.SameAs(applied.AprilFools))
                names.Add(T("Partes do 1º de abril", "April Fools parts"));
            names.AddRange(EventCatalog.PastEvents
                .Where(e => e.NeedsRestart && saved.HasEvent(e.Id) != applied.HasEvent(e.Id))
                .Select(e => e.Name));
            return names;
        }
    }

    private RaidPreview? Preview
    {
        get
        {
            var events = EventSchedule.RaidEvents(working, Now).Concat(working.Events.Where(id => id is "mortarStrike" or "freeLabs" or "softcore")).Distinct().ToList();
            var key = previewMap + "|" + string.Join(",", events);
            if (previewCache is { } cached && cached.Key == key) return cached.Value;
            try
            {
                var value = Previewer.Preview(previewMap, events);
                previewCache = (key, value);
                previewError = null;
                return value;
            }
            catch (Exception ex)
            {
                previewError = T("Não foi possível gerar a prévia: ", "Could not build the preview: ") + ex.Message;
                return null;
            }
        }
    }

    protected override void OnInitialized()
    {
        working = Config.Saved.Clone();
        Config.Changed += OnConfigChanged;
    }

    private void OnConfigChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Config.Changed -= OnConfigChanged;

    private bool IsSeasonalActive(PpesConfig config, string id) => config.ModeOf(id) switch
    {
        SeasonalMode.On => true,
        SeasonalMode.Off => false,
        _ => Calendar.InSeason(id, Today),
    };

    private void SetMode(string id, string mode) => working.Seasonal[id] = mode;

    private bool MapTouched(string mapId) => EventSchedule.RaidEvents(working, Now).Concat(working.Events).Any(id => EventDetails.Of(id).Maps.Contains(mapId));

    private void Toggle(PastEventDef e, bool on)
    {
        working.Events.RemoveAll(x => string.Equals(x, e.Id, StringComparison.OrdinalIgnoreCase));
        if (!on) return;
        foreach (var other in GroupMates(e).Where(o => working.HasEvent(o.Id)).ToList())
        {
            working.Events.RemoveAll(x => string.Equals(x, other.Id, StringComparison.OrdinalIgnoreCase));
            Snackbar.Add(T($"{other.Name} foi desligado: não combina com {e.Name}.", $"{other.Name} was turned off: it can't run with {e.Name}."), Severity.Info);
        }
        working.Events.Add(e.Id);
    }

    private static IEnumerable<PastEventDef> GroupMates(PastEventDef e) =>
        e.Group is null ? [] : EventCatalog.PastEvents.Where(o => o.Group == e.Group && o.Id != e.Id);

    /// <summary>Other picked events changing the same thing, outside an exclusive group (those are handled by Toggle).</summary>
    private List<(string Touch, List<string> Events)> Overlaps(PastEventDef e)
    {
        if (!working.HasEvent(e.Id)) return [];
        var mates = GroupMates(e).Select(m => m.Id).ToHashSet();
        return EventDetails.Of(e.Id).Touches
            .Select(t => (t, working.Events.Where(id => id != e.Id && !mates.Contains(id) && EventDetails.Of(id).Touches.Contains(t)).Select(id => EventCatalog.Past(id)!.Name).ToList()))
            .Where(x => x.Item2.Count > 0)
            .ToList();
    }

    private void Save()
    {
        try
        {
            var saved = Config.Saved;
            var toSave = working.Clone();
            toSave.Language = saved.Language;
            toSave.View = saved.View;
            toSave.GroupByYear = saved.GroupByYear;
            toSave.Presets = saved.Clone().Presets;
            Config.Save(toSave);
            working = Config.Saved.Clone();
            Snackbar.Add(PendingRestart.Count > 0 ? T("Salvo. Reinicie o servidor para aplicar tudo.", "Saved. Restart the server to apply everything.") : T("Salvo.", "Saved."), Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(T("Não foi possível salvar: ", "Could not save: ") + ex.Message, Severity.Error);
        }
    }

    private void Discard() => working = Config.Saved.Clone();

    private void SetLanguage(string language)
    {
        if (Config.Saved.Language != language) Config.Update(c => c.Language = language);
    }

    private void SetView(string view) => Config.Update(c => c.View = view);

    private void ToggleYears() => Config.Update(c => c.GroupByYear = !c.GroupByYear);

    private static Dictionary<string, string> AllAuto() => EventCatalog.Seasonal.ToDictionary(s => s.Id, _ => SeasonalMode.Auto);

    private void ApplyPreset(IEnumerable<string> events, Dictionary<string, string>? seasonal)
    {
        working.Events = ConfigService.NormalizeEvents(events);
        if (seasonal is not null)
            foreach (var (id, mode) in seasonal) working.Seasonal[id] = mode;
        Snackbar.Add(T("Preset aplicado. Confira e salve.", "Preset applied. Review and save."), Severity.Info);
    }

    private void SavePreset()
    {
        var name = presetName.Trim();
        if (name.Length == 0) return;
        var data = new PresetData { Events = [.. working.Events], Seasonal = new(working.Seasonal) };
        Config.Update(c => c.Presets[name] = data);
        presetName = "";
        Snackbar.Add(T($"Preset \"{name}\" salvo.", $"Preset \"{name}\" saved."), Severity.Success);
    }

    private void DeletePreset(string name) => Config.Update(c => c.Presets.Remove(name));

    private RenderFragment Card(PastEventDef e) => __builder =>
    {
        var on = working.HasEvent(e.Id);
        <MudPaper Elevation="0" Class="@($"ppes-card spt-panel {(on ? "ppes-card-on" : "")}")">
            <div class="ppes-card-head">
                <div>
                    <MudText Typo="Typo.h6">@e.Name</MudText>
                    <span class="ppes-meta">@WhenText(e.When)@WikiLink(e.Id)</span>
                </div>
                <MudSwitch T="bool" Value="@on" ValueChanged="@(v => Toggle(e, v))" Color="Color.Warning" aria-label="@e.Name" />
            </div>
            <MudText Typo="Typo.body2" Class="spt-muted">@T(e.DescPt, e.DescEn)</MudText>
            @ImpactChips(e)
            @ConflictNotes(e)
            <div class="ppes-card-foot">
                <span class="@($"ppes-tag ppes-tag-{e.Tag.ToString().ToLowerInvariant()}")">@TagLabel(e.Tag)</span>
                @QuestInfo(EventCatalog.EventQuests(e.Id, e.Quests))
                <span class="ppes-hint ppes-foot-end">@(e.NeedsRestart ? T("Pede reiniciar o servidor", "Needs a server restart") : T("Vale na próxima raid", "Applies from the next raid"))</span>
            </div>
        </MudPaper>
    };

    private RenderFragment ListRow(PastEventDef e) => __builder =>
    {
        var on = working.HasEvent(e.Id);
        <div class="@($"ppes-row-item spt-panel {(on ? "ppes-card-on" : "")}")">
            <MudSwitch T="bool" Value="@on" ValueChanged="@(v => Toggle(e, v))" Color="Color.Warning" aria-label="@e.Name" />
            <div class="ppes-row-main">
                <strong>@e.Name</strong>
                <span class="ppes-meta">@WhenText(e.When)@WikiLink(e.Id)</span>
            </div>
            <span class="ppes-row-desc spt-muted" title="@T(e.DescPt, e.DescEn)">@T(e.DescPt, e.DescEn)</span>
            <span class="ppes-row-kinds">@KindIcons(e)</span>
            @QuestInfo(EventCatalog.EventQuests(e.Id, e.Quests))
            <span class="@($"ppes-tag ppes-tag-{e.Tag.ToString().ToLowerInvariant()}")">@TagLabel(e.Tag)</span>
        </div>
        @ConflictNotes(e)
    };

    private RenderFragment ImpactChips(PastEventDef e) => __builder =>
    {
        var maps = EventDetails.Of(e.Id).Maps;
        <div class="ppes-impact">
            @KindIcons(e)
            @if (maps.Length == EventDetails.Maps.Count)
            {
                <span class="ppes-mapchip">@T("Todos os mapas", "All maps")</span>
            }
            else
            {
                @foreach (var m in EventDetails.Maps.Where(m => maps.Contains(m.Id)))
                {
                    <span class="ppes-mapchip">@T(m.NamePt, m.NameEn)</span>
                }
            }
        </div>
    };

    private RenderFragment KindIcons(PastEventDef e) => __builder =>
    {
        var kinds = EventDetails.KindsOf(e);
        @foreach (var k in KindList.Where(k => kinds.HasFlag(k)))
        {
            <span class="ppes-kind" title="@KindLabel(k)"><MudIcon Icon="@KindIcon(k)" /></span>
        }
    };

    private RenderFragment ConflictNotes(PastEventDef e) => __builder =>
    {
        var mates = GroupMates(e).ToList();
        var overlaps = Overlaps(e);
        if (mates.Count == 0 && overlaps.Count == 0) return;
        <div class="ppes-conflicts">
            @if (mates.Count > 0)
            {
                <span class="ppes-conflict"><MudIcon Icon="@Icons.Material.Filled.Block" /> @T("Só um por vez com: ", "Only one at a time with: ")@string.Join(", ", mates.Select(m => m.Name))</span>
            }
            @foreach (var (touch, names) in overlaps)
            {
                var label = EventDetails.TouchNames.TryGetValue(touch, out var n) ? T(n.Pt, n.En) : touch;
                <span class="ppes-conflict ppes-conflict-soft"><MudIcon Icon="@Icons.Material.Filled.CallSplit" /> @T($"Também mexe em {label}: ", $"Also changes {label}: ")@string.Join(", ", names)</span>
            }
        </div>
    };

    private RenderFragment WikiLink(string eventId) => __builder =>
    {
        if (EventCatalog.WikiUrl(eventId) is not { } url) return;
        <span class="ppes-dot">·</span>
        <a class="ppes-wiki" href="@url" target="_blank" rel="noopener noreferrer" title="@T("Abrir na wiki", "Open on the wiki")">Wiki <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Class="ppes-wiki-icon" /></a>
    };

    // hover (or tap/focus) opens the list; it stays open while the pointer moves into it so links are clickable
    private RenderFragment QuestInfo(IReadOnlyList<QuestLink> quests) => __builder =>
    {
        if (quests.Count == 0) return;
        <span class="ppes-quests" tabindex="0" aria-label="@T("Quests deste evento", "Quests of this event")">
            <MudIcon Icon="@Icons.Material.Outlined.Info" Class="ppes-quests-icon" />
            @(quests.Count == 1 ? "1 quest" : $"{quests.Count} quests")
            <span class="ppes-quests-pop" role="tooltip">
                <span class="ppes-quests-box">
                    <span class="ppes-quests-title">@T("Quests do evento (abre a wiki)", "Event quests (opens the wiki)")</span>
                    @foreach (var q in quests)
                    {
                        var inGame = QuestCheck.Exists(q.Name);
                        <a href="@q.Url" target="_blank" rel="noopener noreferrer" class="@(inGame ? "" : "ppes-quest-missing")"
                           title="@(q.Gated ? T("O PPES libera esta quest; as próximas da cadeia vêm depois dela", "PPES unlocks this quest; the rest of the chain follows it") : null)">
                            @if (q.Gated)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.LockOpen" Class="ppes-quest-gated" />
                            }
                            <span>@q.Name</span>
                            @if (!inGame)
                            {
                                <span class="ppes-quest-note">@T("fora do seu jogo", "not in your game")</span>
                            }
                            <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Class="ppes-wiki-icon" />
                        </a>
                    }
                    @if (quests.Any(q => q.Gated) && quests.Any(q => !q.Gated))
                    {
                        <span class="ppes-quests-legend"><MudIcon Icon="@Icons.Material.Filled.LockOpen" Class="ppes-quest-gated" /> @T("liberada pelo PPES; as outras seguem a cadeia normal", "unlocked by PPES; the others follow the normal chain")</span>
                    }
                </span>
            </span>
        </span>
    };

