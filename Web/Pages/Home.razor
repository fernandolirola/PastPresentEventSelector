    private string MechValue(string key) => (key switch
    {
        "kollontay" => working.Mechanics.KollontayJam,
        "vengeful" => working.Mechanics.VengefulJam,
        "exit" => working.Mechanics.RitualExitTime,
        "stamina" => working.Mechanics.RitualStamina,
        "hydration" => working.Mechanics.ToxinHydration,
        _ => working.Mechanics.ToxinHearing,
    }).ToString(System.Globalization.CultureInfo.InvariantCulture);

    private void SetMech(string key, string? text)
    {
        if (!double.TryParse(text?.Replace(',', '.'), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var v)) return;
        switch (key)
        {
            case "kollontay": working.Mechanics.KollontayJam = Math.Clamp(v, 0, 600); break;
            case "vengeful": working.Mechanics.VengefulJam = v < 0 ? -1 : Math.Clamp(v, 0, 3600); break;
            case "exit": working.Mechanics.RitualExitTime = Math.Clamp(v, 0.1, 20); break;
            case "stamina": working.Mechanics.RitualStamina = Math.Clamp(v, 0.1, 20); break;
            case "hydration": working.Mechanics.ToxinHydration = Math.Clamp(v, 0, 100); break;
            default: working.Mechanics.ToxinHearing = Math.Clamp(v, 0, 100); break;
        }
    }

