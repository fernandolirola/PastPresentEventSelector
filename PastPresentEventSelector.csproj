<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <AssemblyName>PastPresentEventSelector</AssemblyName>
    <RootNamespace>PPES</RootNamespace>
    <Version>1.4.0</Version>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <!-- MoreBotsAPI is referenced, not shipped, so the release still has only the dll, config and wwwroot -->
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SPTushonka.Common" Version="4.1.6" ExcludeAssets="runtime" />
    <PackageReference Include="SPTushonka.DI" Version="4.1.6" ExcludeAssets="runtime" />
    <PackageReference Include="SPTushonka.Server.Core" Version="4.1.6" ExcludeAssets="runtime" />
    <PackageReference Include="SPTushonka.Reflection" Version="4.1.6" ExcludeAssets="runtime" />
    <PackageReference Include="SPTushonka.Server.Web" Version="4.1.6" ExcludeAssets="runtime" />
  </ItemGroup>

  <PropertyGroup>
    <SPTServerPath Condition="'$(SPTServerPath)' == ''">C:\SPT\SPT_Runtime</SPTServerPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="MoreBotsServer">
      <HintPath>$(SPTServerPath)\user\mods\MoreBotsServer\MoreBotsServer.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Content Remove="config.json" />
    <None Include="config.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Remove="wwwroot\**" />
    <None Include="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Quests\*.json" />
    <Content Remove="Quests\*.json" />
    <None Remove="tools\**" />
    <None Remove="research\**" />
    <Content Remove="research\**" />
    <None Remove="PLAN-*.md" />
    <None Remove="pesquisa-eventos.md" />
    <None Remove="release\**" />
    <Content Remove="release\**" />
    <Compile Remove="client\**" />
    <None Remove="client\**" />
    <Content Remove="client\**" />
  </ItemGroup>
</Project>
